%% โค้ดต้นฉบับ: 2_โค้ดภาพอินโฟกราฟิก_แนวตั้ง_9ต่อ16.mmd
flowchart TD
    classDef headerClass fill:#0B2545,stroke:#FF6600,stroke-width:3px,color:#FFFFFF,font-size:26px,font-weight:bold;
    classDef essenceClass fill:#FFF5EB,stroke:#FF6600,stroke-width:2px,color:#111827,font-size:23px;
    classDef oldLawClass fill:#F3F4F6,stroke:#9CA3AF,stroke-width:1px,color:#4B5563,font-size:22px;
    classDef newLawClass fill:#EEF2F6,stroke:#0B2545,stroke-width:2px,color:#0B2545,font-size:22px;
    classDef techSide fill:#0B2545,stroke:#0B2545,stroke-width:2px,color:#FFFFFF,font-size:22px;
    classDef userSide fill:#FF6600,stroke:#FF6600,stroke-width:2px,color:#FFFFFF,font-size:22px;
    classDef penaltyClass fill:#FEF2F2,stroke:#EF4444,stroke-width:2px,color:#991B1B,font-size:22px,font-weight:bold;

    subgraph HEADER ["📢 สรุปเกณฑ์ไอทีฉบับใหม่ (ร่าง)"]
        TitleNode["📜 (ร่าง) ประกาศ ธปท. Digital Channel Security<br/>ความปลอดภัยบริการการเงินผ่านช่องทางดิจิทัล<br/>รับฟัง 7 ต.ค. – 6 พ.ย. 2569 · ยังไม่มีผล"]:::headerClass
    end
    subgraph CORE ["💡 สาระสำคัญที่ต้องรู้"]
        CoreEssence["ขยายจาก Mobile Banking สู่ Internet Banking<br/>และผู้ให้บริการ non-bank · เลิก SMS OTP สำหรับโอน/ถอน"]:::essenceClass
    end
    subgraph COMPARISON ["⚖️ เปรียบเทียบจุดเปลี่ยนสำคัญ (เดิม vs ใหม่)"]
        OldRule["🏛️ ประกาศ 4/2568 ฯลฯ<br/>• เฉพาะแอปมือถือ<br/>• ธนาคาร / SFI / e-Money<br/>• ไม่ห้าม SMS OTP"]:::oldLawClass
        NewRule["🚀 ร่างฉบับรวม<br/>• Internet + Mobile Banking<br/>• เพิ่มบัตรเครดิต / สินเชื่อ<br/>• MFA กันฟิชชิง + Passkey"]:::newLawClass
    end
    subgraph STAKEHOLDERS ["👥 ผู้เกี่ยวข้องและหน้าที่ตามกฎหมาย"]
        TechCompany["🏢 ธนาคาร / e-Money / บัตรเครดิต<br/>/ ผู้พัฒนาแอปการเงิน"]:::techSide
        EndUser["👤 ผู้ใช้บริการบุคคลธรรมดา"]:::userSide
    end
    subgraph FOOTER ["⚠️ บทกำหนดโทษและการบังคับใช้"]
        PenaltyNode["🚨 ไม่มีโทษใหม่ในร่าง · บังคับผ่านกฎหมายแม่บท<br/>มีผล 30 วัน (ATM-MFA 90 วัน) หลังประกาศ<br/>แหล่งอ้างอิง: bot.or.th"]:::penaltyClass
    end
    %% เส้นเชื่อมโยงพร้อมคำอธิบายกำกับบนเส้น
    TitleNode -->|เปิดรับฟังความคิดเห็นก่อนออกประกาศ| CoreEssence
