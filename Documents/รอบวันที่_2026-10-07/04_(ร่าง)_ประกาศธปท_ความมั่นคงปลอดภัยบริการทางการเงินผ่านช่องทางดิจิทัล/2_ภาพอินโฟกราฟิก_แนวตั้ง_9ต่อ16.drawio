<mxfile host="app.diagrams.net"><diagram name="อินโฟกราฟิก 9x16" id="d1"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="1920" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="TitleNode" value="📜 (ร่าง) ประกาศ ธปท. Digital Channel Security&#10;ความปลอดภัยบริการการเงินผ่านช่องทางดิจิทัล&#10;รับฟัง 7 ต.ค. – 6 พ.ย. 2569 · ยังไม่มีผล" style="rounded=1;whiteSpace=wrap;html=0;strokeWidth=2;fillColor=#0B2545;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1000" height="298" as="geometry"/></mxCell><mxCell id="CoreEssence" value="ขยายจาก Mobile Banking สู่ Internet Banking&#10;และผู้ให้บริการ non-bank · เลิก SMS OTP สำหรับโอน/ถอน" style="rounded=1;whiteSpace=wrap;html=0;strokeWidth=2;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="408" width="1000" height="298" as="geometry"/></mxCell><mxCell id="OldRule" value="🏛️ ประกาศ 4/2568 ฯลฯ&#10;• เฉพาะแอปมือถือ&#10;• ธนาคาร / SFI / e-Money&#10;• ไม่ห้าม SMS OTP" style="rounded=1;whiteSpace=wrap;html=0;strokeWidth=2;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontColor=#4B5563;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="776" width="480" height="298" as="geometry"/></mxCell><mxCell id="NewRule" value="🚀 ร่างฉบับรวม&#10;• Internet + Mobile Banking&#10;• เพิ่มบัตรเครดิต / สินเชื่อ&#10;• MFA กันฟิชชิง + Passkey" style="rounded=1;whiteSpace=wrap;html=0;strokeWidth=2;fillColor=#EEF2F6;strokeColor=#0B2545;fontColor=#0B2545;fontSize=14;" vertex="1" parent="1"><mxGeometry x="560" y="776" width="480" height="298" as="geometry"/></mxCell><mxCell id="TechCompany" value="🏢 ธนาคาร / e-Money / บัตรเครดิต&#10;/ ผู้พัฒนาแอปการเงิน" style="rounded=1;whiteSpace=wrap;html=0;strokeWidth=2;fillColor=#0B2545;strokeColor=#0B2545;fontColor=#FFFFFF;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="1144" width="480" height="298" as="geometry"/></mxCell><mxCell id="EndUser" value="👤 ผู้ใช้บริการบุคคลธรรมดา" style="rounded=1;whiteSpace=wrap;html=0;strokeWidth=2;fillColor=#FF6600;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=14;" vertex="1" parent="1"><mxGeometry x="560" y="1144" width="480" height="298" as="geometry"/></mxCell><mxCell id="PenaltyNode" value="🚨 ไม่มีโทษใหม่ในร่าง · บังคับผ่านกฎหมายแม่บท&#10;มีผล 30 วัน (ATM-MFA 90 วัน) หลังประกาศ&#10;แหล่งอ้างอิง: bot.or.th" style="rounded=1;whiteSpace=wrap;html=0;strokeWidth=2;fillColor=#FEF2F2;strokeColor=#EF4444;fontColor=#991B1B;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1512" width="1000" height="298" as="geometry"/></mxCell><mxCell id="e0" value="เปิดรับฟังความคิดเห็นก่อนออกประกาศ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeWidth=2;strokeColor=#0B2545;fontSize=12;fontColor=#111827;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="TitleNode" target="CoreEssence"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="จะยกเลิกประกาศ Mobile Banking 3 ฉบับ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeWidth=2;strokeColor=#0B2545;fontSize=12;fontColor=#111827;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="CoreEssence" target="OldRule"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="รวมเป็นเกณฑ์เดียวทุกผู้ให้บริการ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeWidth=2;strokeColor=#0B2545;fontSize=12;fontColor=#111827;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="CoreEssence" target="NewRule"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="1. ต้องทำ MFA device binding และเลิก SMS OTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeWidth=2;strokeColor=#0B2545;fontSize=12;fontColor=#111827;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="NewRule" target="TechCompany"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="2. ได้แจ้งเตือนทันทีและกัน SIM swap" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeWidth=2;strokeColor=#0B2545;fontSize=12;fontColor=#111827;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="NewRule" target="EndUser"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="3. สแกนใบหน้าเมื่อโอนตั้งแต่ 50,000 บาท" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeWidth=2;strokeColor=#0B2545;fontSize=12;fontColor=#111827;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="TechCompany" target="EndUser"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="4. แจ้งเหตุเมื่อเห็นธุรกรรมผิดปกติ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeWidth=2;strokeColor=#0B2545;fontSize=12;fontColor=#111827;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="EndUser" target="TechCompany"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="หากไม่ปฏิบัติตามหรือไม่ขอผ่อนผัน" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;dashed=1;strokeWidth=2;strokeColor=#0B2545;fontSize=12;fontColor=#111827;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="TechCompany" target="PenaltyNode"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="เกณฑ์เดิมสิ้นผลเมื่อฉบับใหม่ใช้บังคับ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;dashed=1;strokeWidth=2;strokeColor=#0B2545;fontSize=12;fontColor=#111827;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="OldRule" target="PenaltyNode"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
