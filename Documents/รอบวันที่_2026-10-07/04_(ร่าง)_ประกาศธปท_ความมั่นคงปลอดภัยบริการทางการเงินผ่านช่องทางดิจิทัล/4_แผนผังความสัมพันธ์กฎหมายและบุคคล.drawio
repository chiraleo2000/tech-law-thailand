<mxfile host="app.diagrams.net"><diagram name="แผนผังความสัมพันธ์" id="d1"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="CenterLaw" value="📜 (ร่าง) ประกาศ ธปท.&#10;Digital Channel Security&#10;(ศูนย์กลาง)" style="rounded=1;whiteSpace=wrap;html=0;strokeWidth=2;fillColor=#0B2545;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="288" height="1000" as="geometry"/></mxCell><mxCell id="PDPA" value="พ.ร.บ.คุ้มครองข้อมูลส่วนบุคคล 2562&#10;ข้อมูลชีวมิติ ม.26" style="rounded=1;whiteSpace=wrap;html=0;strokeWidth=2;fillColor=#F3F4F6;strokeColor=#0B2545;fontColor=#0B2545;fontSize=13;" vertex="1" parent="1"><mxGeometry x="408" y="40" width="288" height="227" as="geometry"/></mxCell><mxCell id="TechCrime" value="พ.ร.ก.ปราบปรามอาชญากรรม&#10;ทางเทคโนโลยี 2566" style="rounded=1;whiteSpace=wrap;html=0;strokeWidth=2;fillColor=#F3F4F6;strokeColor=#0B2545;fontColor=#0B2545;fontSize=13;" vertex="1" parent="1"><mxGeometry x="408" y="297" width="288" height="227" as="geometry"/></mxCell><mxCell id="CyberLaw" value="พ.ร.บ.ไซเบอร์ 2562&#10;และ TB-CERT" style="rounded=1;whiteSpace=wrap;html=0;strokeWidth=2;fillColor=#F3F4F6;strokeColor=#0B2545;fontColor=#0B2545;fontSize=13;" vertex="1" parent="1"><mxGeometry x="408" y="554" width="288" height="227" as="geometry"/></mxCell><mxCell id="FIBA" value="พ.ร.บ.ธุรกิจสถาบันการเงิน 2551&#10;/ พ.ร.บ.ระบบการชำระเงิน 2560" style="rounded=1;whiteSpace=wrap;html=0;strokeWidth=2;fillColor=#F3F4F6;strokeColor=#0B2545;fontColor=#0B2545;fontSize=13;" vertex="1" parent="1"><mxGeometry x="408" y="811" width="288" height="227" as="geometry"/></mxCell><mxCell id="Bank" value="ธนาคาร / SFI / e-Money" style="rounded=1;whiteSpace=wrap;html=0;strokeWidth=2;fillColor=#FFF5EB;strokeColor=#FF6600;fontCol