<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram name="อินโฟกราฟิก 9x16" id="d1">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="1920" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="TitleNode" value="📜 แนวทาง สคส. คุ้มครองข้อมูลส่วนบุคคลกับ AI (v1.0)&#10;เผยแพร่ 7 ต.ค. 2569" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B2545;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="20" width="500" height="100" as="geometry" /></mxCell>
        <mxCell id="CoreEssence" value="นำ PDPA มาใช้กับ AI ทั้ง Analytic / Generative / Agentic AI ตลอดวงจรชีวิตระบบ เป็นแนวทางเชิงแนะนำ ไม่มีสภาพบังคับ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="260" y="180" width="560" height="100" as="geometry" /></mxCell>
        <mxCell id="OldRule" value="🏛️ เดิม&#10;• PDPA เป็นกลางทางเทคโนโลยี ต้องตีความเองว่าใช้กับ AI อย่างไร&#10;• มักพึ่งความยินยอมเป็นหลัก" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontColor=#4B5563;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="460" height="150" as="geometry" /></mxCell>
        <mxCell id="NewRule" value="🚀 แนวทางใหม่ v1.0&#10;• Prompt / Log / Embedding / Output อาจเป็นข้อมูลส่วนบุคคล&#10;• ความยินยอมเป็นทางเลือกสุดท้าย ใช้ ม.24/26 + LIA ก่อน&#10;• ทำ DPIA ก่อนเริ่มโครงการเสี่ยงสูง" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2F6;strokeColor=#0B2545;fontColor=#0B2545;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="350" width="460" height="170" as="geometry" /></mxCell>
        <mxCell id="TechCompany" value="🏢 องค์กรที่พัฒนา/ใช้ AI&#10;(ผู้ควบคุม/ผู้ประมวลผลข้อมูล)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B2545;strokeColor=#0B2545;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="600" width="400" height="100" as="geometry" /></mxCell>
        <mxCell id="EndUser" value="👤 เจ้าของข้อมูล&#10;/ ผู้ใช้งาน AI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF6600;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="600" width="400" height="100" as="geometry" /></mxCell>
        <mxCell id="PenaltyNode" value="🚨 แนวทางไม่มีโทษในตัวเอง แต่ละเมิด PDPA ยังมีโทษ (ปรับทางปกครองสูงสุด 5 ล้านบาท) และต้องแจ้งเหตุละเมิด สคส. ภายใน 72 ชม.&#10;แหล่งอ้างอิง: pdpc.or.th/28888" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;fontColor=#991B1B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="800" width="680" height="130" as="geometry" /></mxCell>
        <mxCell id="e0" value="เผยแพร่เป็นแนวทางตามมาตรา 16 (3) PDPA" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=10;" edge="1" parent="1" source="TitleNode" target="CoreEssence"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e1" value="เติมช่องว่างจากแนวปฏิบัติเดิมที่ไม่เฉพาะ AI" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=10;" edge="1" parent="1" source="CoreEssence" target="OldRule"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="กำหนดแนวทางเฉพาะด้าน AI ตามวงจรชีวิตระบบ" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=10;" edge="1" parent="1" source="CoreEssence" target="NewRule"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="1. ระบุบทบาท ฐานกฎหมาย ทำ DPIA และมาตรการ Guardrails" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=10;" edge="1" parent="1" source="NewRule" target="TechCompany"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="2. คุ้มครองสิทธิเข้าถึง ลบ คัดค้าน แม้เทคโนโลยีซับซ้อน" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=10;" edge="1" parent="1" source="NewRule" target="EndUser"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="3. ให้บริการโปร่งใส แจ้งวัตถุประสงค์ ไม่ฝึกโมเดลโดยพลการ" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=10;" edge="1" parent="1" source="TechCompany" target="EndUser"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="4. ใช้สิทธิร้องขอ เช่น ลบข้อมูลออกจากระบบ AI" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=10;" edge="1" parent="1" source="EndUser" target="TechCompany"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="หากละเลย PDPA เมื่อใช้ AI อาจถูกลงโทษ" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=10;dashed=1;" edge="1" parent="1" source="TechCompany" target="PenaltyNode"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="โทษตาม PDPA ยังใช้บังคับเหมือนเดิม" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=10;dashed=1;" edge="1" parent="1" source="OldRule" target="PenaltyNode"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
