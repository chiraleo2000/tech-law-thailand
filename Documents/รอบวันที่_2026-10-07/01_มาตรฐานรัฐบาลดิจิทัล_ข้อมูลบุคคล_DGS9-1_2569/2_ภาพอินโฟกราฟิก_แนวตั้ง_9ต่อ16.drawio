        <mxCell id="n_title" value="📜 มาตรฐานข้อมูลบุคคล DGS 9-1:2569&#10;ประกาศราชกิจจาฯ 25 ก.ย. 2569" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B2545;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="20" width="400" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n_core" value="กำหนดสคีมาและรูปแบบแลกเปลี่ยนข้อมูลบุคคลกลาง อ้างอิงทะเบียนราษฎรกรมการปกครอง ใช้ร่วมกันทุกหน่วยงานรัฐ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="310" y="160" width="460" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n_old" value="🏛️ มาตรฐานเดิม มสพร. 4-2565&#10;- ครอบคลุมเฉพาะข้อมูลอ้างอิงพื้นฐาน&#10;- ไม่มีพจนานุกรมข้อมูลครบทุกฟิลด์" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontColor=#4B5563;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="320" width="380" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n_new" value="🚀 DGS 9-1:2569&#10;- ข้อมูลบุคคลฉบับเต็ม 7 องค์ประกอบ&#10;- มีสคีมา XML/JSON ครบชุด" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2F6;strokeColor=#0B2545;fontColor=#0B2545;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="320" width="380" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n_tech" value="🏢 หน่วยงานรัฐผู้พัฒนาระบบเชื่อมโยงข้อมูล" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B2545;strokeColor=#0B2545;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="150" y="500" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n_user" value="👤 ประชาชนเจ้าของข้อมูล" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF6600;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="610" y="500" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n_penalty" value="🚨 มาตรฐานทางเทคนิค ไม่มีบทลงโทษอาญา แต่หน่วยงานรัฐต้องถือปฏิบัติตามกรอบ TGIX&#10;แหล่งอ้างอิง: standard.dga.or.th/dgs-19-1-and-19-2-2569" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;fontColor=#991B1B;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="650" width="560" height="130" as="geometry" />
