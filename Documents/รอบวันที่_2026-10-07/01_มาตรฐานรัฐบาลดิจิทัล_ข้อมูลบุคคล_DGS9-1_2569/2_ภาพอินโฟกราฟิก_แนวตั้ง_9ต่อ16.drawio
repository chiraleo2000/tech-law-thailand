        <mxCell id="e1" value="ประกาศใช้ภายใต้กรอบ TGIX Semantic Standards" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#4B5563;" edge="1" parent="1" source="n_title" target="n_core">
