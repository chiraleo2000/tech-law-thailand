<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram name="อินโฟกราฟิก 9x16" id="d1">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="1920" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="TitleNode" value="📜 (ร่าง) หลักการ ก.ล.ต. ธุรกรรม in-kind&#10;ของกองทุนรวมโทเคน (tokenized fund) · อนจ. 84/2569&#10;รับฟังความเห็นถึง 11 ธ.ค. 2569 · ยังไม่มีผล" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B2545;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=13;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="200" y="40" width="680" height="150" as="geometry" /></mxCell>
        <mxCell id="CoreEssence" value="tokenized fund ที่ซื้อขายได้ใน T0 รับชำระค่าซื้อ/ชำระค่าขายคืน&#10;เป็นหลักทรัพย์หรือทรัพย์สินอื่นแทนเงิน กับ LBDU ที่ดูแลสภาพคล่อง" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="160" y="270" width="760" height="150" as="geometry" /></mxCell>
        <mxCell id="OldRule" value="🏛️ เดิม (ทน. 3/2556 · ทน. 11/2564 · สน. 9/2564)&#10;• รับชำระค่าซื้อเป็นเงินสดเท่านั้น&#10;• redemption-in-kind เฉพาะ 4 กรณี&#10;• tokenized fund T0 ได้แล้ว (1 เม.ย. 2569)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontColor=#4B5563;fontSize=13;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="470" height="240" as="geometry" /></mxCell>
        <mxCell id="NewRule" value="🚀 ใหม่ (ร่างหลักการ)&#10;• in-kind ได้ทั้งขาซื้อและขาขายคืน&#10;• เฉพาะกองทุนรวมเปิด + LBDU ≥ 1 ราย&#10;• LBDU เสนอราคาต่อเนื่อง/ประกาศชื่อกองทุน&#10;• คาดมีผลไตรมาส 2/2570" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2F6;strokeColor=#0B2545;fontColor=#0B2545;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="570" y="520" width="470" height="240" as="geometry" /></mxCell>
        <mxCell id="TechCompany" value="🏢 บลจ. / LBDU (นายหน้า ค้า จัดจำหน่ายหน่วยลงทุน)&#10;+ ระบบ blockchain ของกองทุน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B2545;strokeColor=#0B2545;fontColor=#FFFFFF;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="470" height="150" as="geometry" /></mxCell>
        <mxCell id="EndUser" value="👤 ผู้ลงทุน tokenized fund" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF6600;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="570" y="900" width="470" height="150" as="geometry" /></mxCell>
        <mxCell id="PenaltyNode" value="🚨 ไม่มีโทษใหม่: ใช้บทบัญญัติเดิมตาม พ.ร.บ.หลักทรัพย์ฯ 2535&#10;ไม่เพิ่มระบบอนุญาต/ดุลพินิจ&#10;แหล่งอ้างอิง: sec.or.th (อนจ. 84/2569)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;fontColor=#991B1B;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="160" y="1300" width="760" height="170" as="geometry" /></mxCell>
        <mxCell id="e0" value="CoreEssence" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;strokeWidth=2;fontSize=11;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="TitleNode" target="คณะกรรมการกำกับตลาดทุนเห็นชอบหลักการ 17 พ.ย. 2569"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e1" value="OldRule" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;strokeWidth=2;fontSize=11;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="CoreEssence" target="ผ่อนข้อจำกัด pay-in-cash เดิม"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="NewRule" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;strokeWidth=2;fontSize=11;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="CoreEssence" target="เปิดธุรกรรม in-kind ภายใต้เงื่อนไข"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="TechCompany" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;strokeWidth=2;fontSize=11;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="NewRule" target="1. ระบุ LBDU ในโครงการ + เชื่อมระบบ in-kind"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="EndUser" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;strokeWidth=2;fontSize=11;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="NewRule" target="2. รับหน่วย/รับเงินขายคืนได้ในวันเดียว (T0)"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="EndUser" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;strokeWidth=2;fontSize=11;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="TechCompany" target="3. เปิดเผย settlement risk และข้อมูล LBDU"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="TechCompany" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;strokeWidth=2;fontSize=11;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="EndUser" target="4. ศึกษาเงื่อนไข T0 / ส่งความเห็นถึง 11 ธ.ค."><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="PenaltyNode" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;strokeWidth=2;dashed=1;fontSize=11;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="TechCompany" target="หากทำ in-kind นอกเงื่อนไขโครงการ"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="PenaltyNode" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;strokeWidth=2;dashed=1;fontSize=11;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="OldRule" target="คงบทลงโทษเดิมตาม พ.ร.บ.หลักทรัพย์ฯ"><mxGeometry relative="1" as="geometry" /></mxCell>
