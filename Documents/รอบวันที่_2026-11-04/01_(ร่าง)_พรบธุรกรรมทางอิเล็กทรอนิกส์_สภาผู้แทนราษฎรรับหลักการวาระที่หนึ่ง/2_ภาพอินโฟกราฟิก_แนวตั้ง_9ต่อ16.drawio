<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net"><diagram name="อินโฟกราฟิก 9x16" id="d1"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="1920" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="TitleNode" value="📜 (ร่าง) พ.ร.บ.ธุรกรรมทางอิเล็กทรอนิกส์ พ.ศ. ....&#10;สภารับหลักการ 4 พ.ย. 2569 · 459 เสียง&#10;แปรญัตติถึง 19 พ.ย. 2569 · ยังไม่มีผล" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#0B2545;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=18;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="190" y="50" width="700" height="170" as="geometry"/></mxCell><mxCell id="CoreEssence" value="ยกเครื่องกฎหมายปี 2544 ทั้งฉบับ&#10;ให้ธุรกรรมออนไลน์เป็นช่องทางหลัก และกำกับบริการตามความเสี่ยง" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontSize=16;fontStyle=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="190" y="300" width="700" height="120" as="geometry"/></mxCell><mxCell id="OldRule" value="🏛️ กฎหมายปัจจุบัน&#10;• ขออนุญาต จดทะเบียน จดแจ้ง&#10;• ไม่มีหมวดตราสารเปลี่ยนมือ&#10;• ไม่มีบทสัญญาอัตโนมัติ" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontColor=#4B5563;fontSize=15;fontStyle=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="520" width="430" height="230" as="geometry"/></mxCell><mxCell id="NewRule" value="🚀 ร่างใหม่&#10;• บริการ 7 ประเภท + สพธอ. รับรอง&#10;• รองรับ Smart Contract และ AI&#10;• เช็ค ตั๋วเงินอิเล็กทรอนิกส์&#10;• ใช้บังคับเมื่อพ้น 180 วัน" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EEF2F6;strokeColor=#0B2545;fontColor=#0B2545;fontSize=15;fontStyle=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="580" y="520" width="430" height="270" as="geometry"/></mxCell><mxCell id="TechCompany" value="🏢 ผู้ให้บริการ e-KYC ลายเซ็น เก็บข้อมูล โดเมน" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#0B2545;strokeColor=#0B2545;fontColor=#FFFFFF;fontSize=15;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="950" width="430" height="150" as="geometry"/></mxCell><mxCell id="EndUser" value="👤 ประชาชน / ผู้ใช้บริการดิจิทัล" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FF6600;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=15;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="580" y="950" width="430" height="150" as="geometry"/></mxCell><mxCell id="PenaltyNode" value="⚠️ ไม่มีโทษอาญาในร่าง&#10;ผู้ให้บริการรับผิดทางแพ่งถ้าไม่ทำตามหน้าที่&#10;แหล่งอ้างอิง: lis.parliament.go.th" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FEF2F2;strokeColor=#EF4444;fontColor=#991B1B;fontSize=15;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="140" y="1280" width="800" height="190" as="geometry"/></mxCell><mxCell id="e0" value="สภาลงมติรับหลักการ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontSize=11;" edge="1" parent="1" source="TitleNode" target="CoreEssence"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="ปรับปรุงกฎหมายเดิมทั้งฉบับ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontSize=11;" edge="1" parent="1" source="CoreEssence" target="OldRule"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="เปลี่ยนเป็นมาตรฐานและการรับรอง" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontSize=11;" edge="1" parent="1" source="CoreEssence" target="NewRule"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="1. มีระบบ ความเสี่ยง ไซเบอร์ เยียวยา" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontSize=11;" edge="1" parent="1" source="NewRule" target="TechCompany"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="2. ใช้ธุรกรรมออนไลน์ได้กว้างขึ้น" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontSize=11;" edge="1" parent="1" source="NewRule" target="EndUser"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="3. แจ้งวัตถุประสงค์และข้อจำกัด" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontSize=11;" edge="1" parent="1" source="TechCompany" target="EndUser"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="4. ร้องเรียนและเรียกค่าเสียหาย" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontSize=11;" edge="1" parent="1" source="EndUser" target="TechCompany"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="หากไม่ปฏิบัติตามหน้าที่" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontSize=11;dashed=1;" edge="1" parent="1" source="TechCompany" target="PenaltyNode"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="ยกเลิกระบบเดิมตามบทเฉพาะกาล" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontSize=11;dashed=1;" edge="1" parent="1" source="OldRule" target="PenaltyNode"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
