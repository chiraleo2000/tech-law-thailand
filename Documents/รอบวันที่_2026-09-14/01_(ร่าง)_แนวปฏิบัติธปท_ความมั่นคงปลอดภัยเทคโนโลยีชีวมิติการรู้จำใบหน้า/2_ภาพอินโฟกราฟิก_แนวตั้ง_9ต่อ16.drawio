<mxfile host="app.diagrams.net"><diagram name="อินโฟกราฟิก 9x16" id="d1"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="1920" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="TitleNode" value="📜 (ร่าง) แนวปฏิบัติ ธปท.&#10;ความปลอดภัยการสแกนใบหน้า Facial Recognition&#10;รับฟัง 14 ก.ย. – 13 ต.ค. 2569 · ยังไม่ออกใช้" style="rounded=1;whiteSpace=wrap;html=0;strokeWidth=2;fillColor=#0B2545;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1000" height="298" as="geometry"/></mxCell><mxCell id="CoreEssence" value="รับมือ Deepfake และ Video Injection&#10;FMR ≤ 0.01% · IAPAR ≤ 4% ต่อสื่อโจมตี" style="rounded=1;whiteSpace=wrap;html=0;strokeWidth=2;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="408" width="1000" height="298" as="geometry"/></mxCell><mxCell id="OldRule" value="🏛️ แนวปฏิบัติ 2566&#10;• ชีวมิติทุกประเภท&#10;• FAR ≤ 0.1% / FRR ≤ 3%&#10;• รายงานทุก 6 เดือน" style="rounded=1;whiteSpace=wrap;html=0;strokeWidth=2;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontColor=#4B5563;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="776" width="480" height="298" as="geometry"/></mxCell><mxCell id="NewRule" value="🚀 ร่าง 2569&#10;• เฉพาะใบหน้า เกณฑ์ตัวเลขชัด&#10;• ทดสอบ 300,000 ธุรกรรม&#10;• VA 3 เดือน · Pentest ปีละครั้ง" style="rounded=1;whiteSpace=wrap;html=0;strokeWidth=2;fillColor=#EEF2F6;strokeColor=#0B2545;fontColor=#0B2545;fontSize=14;" vertex="1" parent="1"><mxGeometry x="560" y="776" width="480" height="298" as="geometry"/></mxCell><mxCell id="TechCompany" value="🏢 ธนาคาร / e-Money / สินเชื่อ&#10;/ ผู้ให้บริการ eKYC-IdP" style="rounded=1;whiteSpace=wrap;html=0;strokeWidth=2;fillColor=#0B2545;strokeColor=#0B2545;fontColor=#FFFFFF;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="1144" width="480" height="298" as="geometry"/></mxCell><mxCell id="EndUser" value="👤 ผู้ใช้บริการที่สแกนใบหน้า" style="rounded=1;whiteSpace=wrap;html=0;strokeWidth=2;fillColor=#FF6600;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=14;" vertex="1" parent="1"><mxGeometry x="560" y="1144" width="480" height="298" as="geometry"/></mxCell><mxCell id="PenaltyNode" value="🚨 ไม่มีโทษใหม่ · รายงานผลทดสอบภายใน 90 วัน&#10;ธปท. สั่งทดสอบเพิ่มรายกรณีได้&#10;แหล่งอ้างอิง: bot.or.th" style="rounded=1;whiteSpace=wrap;html=0;strokeWidth=2;fillColor=#FEF2F2;strokeColor=#EF4444;fontColor=#991B1B;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1512" width="1000" height="298" as="geometry"/></mxCell><mxCell id="e0" value="เปิดรับฟังความคิดเห็นก่อนออกใช้" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeWidth=2;strokeColor=#0B2545;fontSize=12;fontColor=#111827;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="TitleNode" target="CoreEssence"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="จะยกเลิกแนวปฏิบัติชีวมิติปี 2566" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeWidth=2;strokeColor=#0B2545;fontSize=12;fontColor=#111827;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="CoreEssence" target="OldRule"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="ตั้งเกณฑ์ทดสอบตามมาตรฐานสากล" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeWidth=2;strokeColor=#0B2545;fontSize=12;fontColor=#111827;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="CoreEssence" target="NewRule"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="1. ทดสอบ FMR/IAPAR และห้ามผู้รับจ้างเก็บภาพ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeWidth=2;strokeColor=#0B2545;fontSize=12;fontColor=#111827;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="NewRule" target="TechCompany"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="2. ได้รับการป้องกันการปลอมใบหน้า" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeWidth=2;strokeColor=#0B2545;fontSize=12;fontColor=#111827;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="NewRule" target="EndUser"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="3. แนะนำวิธีสแกนและ liveness แบบสุ่ม" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeWidth=2;strokeColor=#0B2545;fontSize=12;fontColor=#111827;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="TechCompany" target="EndUser"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="4. ใช้ช่องทางยืนยันอื่นเมื่อถูกระงับ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeWidth=2;strokeColor=#0B2545;fontSize=12;fontColor=#111827;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="EndUser" target="TechCompany"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="หากผลทดสอบเกินเกณฑ์หรือไม่รายงาน" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;dashed=1;strokeWidth=2;strokeColor=#0B2545;fontSize=12;fontColor=#111827;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="TechCompany" target="PenaltyNode"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="แบบรายงานเดิมยุติเมื่อฉบับใหม่ออก" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;dashed=1;strokeWidth=2;strokeColor=#0B2545;fontSize=12;fontColor=#111827;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="OldRule" target="PenaltyNode"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
