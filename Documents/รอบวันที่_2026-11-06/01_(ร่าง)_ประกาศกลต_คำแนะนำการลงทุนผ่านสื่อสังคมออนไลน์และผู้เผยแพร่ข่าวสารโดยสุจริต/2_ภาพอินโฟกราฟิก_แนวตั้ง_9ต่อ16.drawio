<mxfile host="app.diagrams.net"><diagram name="อินโฟกราฟิก 9x16" id="d1"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="1920" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="TitleNode" value="📜 (ร่าง) ประกาศ ก.ล.ต. คำแนะนำลงทุนผ่านสื่อ&#10;อนป. 77/2569 · รับฟังถึง 6 ธ.ค. 2569&#10;ยังไม่มีผล" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#0B2545;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=18;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="190" y="50" width="700" height="170" as="geometry"/></mxCell><mxCell id="CoreEssence" value="ขยายเกณฑ์ถึงสื่อสังคมออนไลน์&#10;ข้อยกเว้นใช้เฉพาะผู้เผยแพร่ข่าวสารโดยสุจริต" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontSize=16;fontStyle=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="190" y="300" width="700" height="120" as="geometry"/></mxCell><mxCell id="OldRule" value="🏛️ เกณฑ์ปัจจุบัน&#10;• วิทยุ ทีวี หนังสือพิมพ์ สิ่งพิมพ์&#10;• ไม่จำกัดผู้เผยแพร่ชัดเจน" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontColor=#4B5563;fontSize=15;fontStyle=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="520" width="430" height="230" as="geometry"/></mxCell><mxCell id="NewRule" value="🚀 ร่างใหม่&#10;• รวมโซเชียลและทุกช่องทาง&#10;• มีกลไกรับผิดชอบเนื้อหา&#10;• รายได้ไม่อิงการตัดสินใจลงทุน" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EEF2F6;strokeColor=#0B2545;fontColor=#0B2545;fontSize=15;fontStyle=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="580" y="520" width="430" height="270" as="geometry"/></mxCell><mxCell id="TechCompany" value="🏢 สื่อออนไลน์ / แพลตฟอร์มคอนเทนต์ / finfluencer" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#0B2545;strokeColor=#0B2545;fontColor=#FFFFFF;fontSize=15;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="950" width="430" height="150" as="geometry"/></mxCell><mxCell id="EndUser" value="👤 ผู้ลงทุน / ผู้ติดตามออนไลน์" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FF6600;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=15;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="580" y="950" width="430" height="150" as="geometry"/></mxCell><mxCell id="PenaltyNode" value="⚠️ หากเข้าข่ายที่ปรึกษาการลงทุนโดยไม่ได้รับอนุญาต&#10;อาจมีโทษตาม ม.289 พ.ร.บ.หลักทรัพย์ฯ / ม.125 พ.ร.บ.สัญญาซื้อขายล่วงหน้า&#10;แหล่งอ้างอิง: sec.or.th" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FEF2F2;strokeColor=#EF4444;fontColor=#991B1B;fontSize=15;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="140" y="1280" width="800" height="190" as="geometry"/></mxCell><mxCell id="e0" value="ก.ล.ต. เปิดรับฟังร่าง 2 ฉบับ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontSize=11;" edge="1" parent="1" source="TitleNode" target="CoreEssence"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="แก้ไข กธ. 1/2560 และ กธ. 2/2560" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontSize=11;" edge="1" parent="1" source="CoreEssence" target="OldRule"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="กำหนดเงื่อนไขข้อยกเว้นใหม่" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontSize=11;" edge="1" parent="1" source="CoreEssence" target="NewRule"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="1. จัดระบบกำกับเนื้อหา" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontSize=11;" edge="1" parent="1" source="NewRule" target="TechCompany"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="2. ได้รับความคุ้มครองเพิ่มขึ้น" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontSize=11;" edge="1" parent="1" source="NewRule" target="EndUser"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="3. เผยแพร่ข่าวสารทั่วไปอย่างรับผิดชอบ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontSize=11;" edge="1" parent="1" source="TechCompany" target="EndUser"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="4. ตรวจสอบผู้ให้คำแนะนำ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontSize=11;" edge="1" parent="1" source="EndUser" target="TechCompany"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="หากไม่เข้าข้อยกเว้น" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontSize=11;dashed=1;" edge="1" parent="1" source="TechCompany" target="PenaltyNode"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="คงบทกำหนดโทษตาม พ.ร.บ. เดิม" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontSize=11;dashed=1;" edge="1" parent="1" source="OldRule" target="PenaltyNode"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
