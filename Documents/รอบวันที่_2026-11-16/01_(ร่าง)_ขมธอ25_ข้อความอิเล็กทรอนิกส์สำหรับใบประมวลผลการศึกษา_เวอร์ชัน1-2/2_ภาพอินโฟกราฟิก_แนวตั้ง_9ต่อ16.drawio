<mxfile host="app.diagrams.net"><diagram name="อินโฟกราฟิก 9x16" id="d1"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="1920" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="TitleNode" value="📜 (ร่าง) ขมธอ. 25 เวอร์ชัน 1.2&#10;ข้อความอิเล็กทรอนิกส์สำหรับใบประมวลผลการศึกษา&#10;เวียนร่าง 16 พ.ย. – 18 ธ.ค. 2569 · ยังไม่มีผล" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#0B2545;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=15;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="190" y="50" width="700" height="170" as="geometry"/></mxCell><mxCell id="CoreEssence" value="เพิ่มโครงสร้างข้อมูล JSON คู่กับ XML&#10;รองรับ API และ Verifiable Credentials" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontSize=15;fontStyle=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="190" y="300" width="700" height="120" as="geometry"/></mxCell><mxCell id="OldRule" value="🏛️ ขมธอ. 25-2563&#10;• XML อย่างเดียว&#10;• ลงนามแบบ XAdES (ขมธอ. 14)&#10;• Package 4 รายการ" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontColor=#4B5563;fontSize=15;fontStyle=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="520" width="430" height="230" as="geometry"/></mxCell><mxCell id="NewRule" value="🚀 ร่างเวอร์ชัน 1.2&#10;• XML + JSON Schema&#10;• PDF/A-3 (ขมธอ. 11) หรือ VC (ขมธอ. 24)&#10;• คง 6 ชุดข้อมูลเดิม" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EEF2F6;strokeColor=#0B2545;fontColor=#0B2545;fontSize=15;fontStyle=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="580" y="520" width="430" height="230" as="geometry"/></mxCell><mxCell id="TechCompany" value="🏢 สถาบันการศึกษา / ผู้พัฒนาระบบทะเบียนและ VC" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#0B2545;strokeColor=#0B2545;fontColor=#FFFFFF;fontSize=15;fontStyle=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="190" y="900" width="700" height="110" as="geometry"/></mxCell><mxCell id="EndUser" value="👤 ผู้เรียน และผู้ตรวจสอบ เช่น นายจ้าง" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FF6600;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=15;fontStyle=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="190" y="1150" width="700" height="110" as="geometry"/></mxCell><mxCell id="PenaltyNode" value="ℹ️ มาตรฐานแนะนำ ไม่มีบทกำหนดโทษ&#10;ส่งความเห็นได้ถึง 18 ธ.ค. 2569&#10;แหล่งอ้างอิง: etda.or.th (StandardNews 16 พ.ย. 2569)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FEF2F2;strokeColor=#EF4444;fontColor=#991B1B;fontSize=15;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="190" y="1500" width="700" height="170" as="geometry"/></mxCell><mxCell id="e0" value="สพธอ. เวียนร่างรับฟังความเห็น" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=12;labelBackgroundColor=#F8F9FA;strokeColor=#0B2545;strokeWidth=1.5;" edge="1" parent="1" source="TitleNode" target="CoreEssence"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="ปรับปรุงจากฉบับปี 2563" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=12;labelBackgroundColor=#F8F9FA;strokeColor=#0B2545;strokeWidth=1.5;" edge="1" parent="1" source="CoreEssence" target="OldRule"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="เพิ่มรูปแบบและวิธีลงนามใหม่" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=12;labelBackgroundColor=#F8F9FA;strokeColor=#0B2545;strokeWidth=1.5;" edge="1" parent="1" source="CoreEssence" target="NewRule"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="1. ส่งออกข้อมูล JSON และลงนาม" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=12;labelBackgroundColor=#F8F9FA;strokeColor=#0B2545;strokeWidth=1.5;" edge="1" parent="1" source="NewRule" target="TechCompany"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="2. ได้ใบดิจิ