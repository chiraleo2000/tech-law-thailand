<mxfile host="thai-tech-law-pipeline"><diagram name="หน้า-1"><mxGraphModel dx="1920" dy="1080" grid="1" gridSize="10" pageWidth="1920" pageHeight="1080" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="CenterLaw" value="📜 (ร่าง) พ.ร.บ.เศรษฐกิจแพลตฟอร์มดิจิทัล&lt;br/&gt;91 มาตรา 9 หมวด&lt;br/&gt;(ศูนย์กลาง — สถานะร่าง)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B2545;strokeColor=#FF6600;fontColor=#FFFFFF;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="430" height="150" as="geometry"/></mxCell><mxCell id="ETA" value="พ.ร.บ.ธุรกรรมทางอิเล็กทรอนิกส์ 2544&lt;br/&gt;+ พ.ร.ฎ. DPS 2565 (ถูกยกเลิก)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#0B2545;fontColor=#0B2545;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="510" y="40" width="430" height="150" as="geometry"/></mxCell><mxCell id="CompLaw" value="พ.ร.บ.คอมพิวเตอร์ฯ 2550&lt;br/&gt;+ พ.ร.ก.อาชญากรรมทางเทคโนโลยี" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#0B2545;fontColor=#0B2545;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="980" y="40" width="430" height="150" as="geometry"/></mxCell><mxCell id="PDPA" value="พ.ร.บ.คุ้มครองข้อมูลส่วนบุคคล 2562" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#0B2545;fontColor=#0B2545;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="1450" y="40" width="430" height="150" as="geometry"/></mxCell><mxCell id="TCCT" value="พ.ร.บ.การแข่งขันทางการค้า 2560&lt;br/&gt;+ พ.ร.บ.คุ้มครองผู้บริโภค" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#0B2545;fontColor=#0B2545;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="430" height="150" as="geometry"/></mxCell><mxCell id="TechDev" value="แพลตฟอร์มตลาดสินค้า / โซเชียล / เรียกรถ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="510" y="280" width="430" height="150" as="geometry"/></mxCell><mxCell id="TechInfra" value="ผู้ให้บริการสื่อกลาง (ท่อรับส่ง แคช โฮสติ้ง)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="980" y="280" width="430" height="150" as="geometry"/></mxCell><mxCell id="Foreign" value="แพลตฟอร์มต่างประเทศ + ตัวแทนในไทย" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="1450" y="280" width="430" height="150" as="geometry"/></mxCell><mxCell id="User" value="ผู้ใช้ / ผู้บริโภค" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;fontColor=#166534;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="430" height="150" as="geometry"/></mxCell><mxCell id="Seller" value="ผู้ขายรายย่อย / SMEs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;fontColor=#166534;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="510" y="520" width="430" height="150" as="geometry"/></mxCell><mxCell id="Board" value="คณะกรรมการเศรษฐกิจแพลตฟอร์มดิจิทัล&lt;br/&gt;(ปลัด ดศ. ประธาน)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;fontColor=#991B1B;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="980" y="520" width="430" height="150" as="geometry"/></mxCell><mxCell id="Office" value="สำนักงานคณะกรรมการฯ (สป.ดศ.)&lt;br/&gt;ETDA ทำแทนชั่วคราว" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;fontColor=#991B1B;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="1450" y="520" width="430" height="150" as="geometry"/></mxCell><mxCell id="e0" value="1. ยกเลิก พ.ร.ฎ. DPS และแยกออกจากกรอบธุรกรรมฯ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontFamily=Tahoma;" edge="1" parent="1" source="CenterLaw" target="ETA"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="2. Safe Harbor ซ้อนหน้าที่ผู้ให้บริการและการระงับเนื้อหา" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontFamily=Tahoma;" edge="1" parent="1" source="CenterLaw" target="CompLaw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="3. รายงานข้อมูล/เข้าถึงระบบต้องมีฐานทางกฎหมาย" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontFamily=Tahoma;" edge="1" parent="1" source="CenterLaw" target="PDPA"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="4. แพลตฟอร์มมีนัยสำคัญตัดกับกฎหมายแข่งขัน/ผู้บริโภค" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontFamily=Tahoma;" edge="1" parent="1" source="CenterLaw" target="TCCT"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="5. หน้าที่หมวด 4–6 ห้ามรีวิวปลอม" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontFamily=Tahoma;strokeWidth=3;" edge="1" parent="1" source="CenterLaw" target="TechDev"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="6. คุ้มครองตามเงื่อนไข Safe Harbor" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontFamily=Tahoma;strokeWidth=3;" edge="1" parent="1" source="CenterLaw" target="TechInfra"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="7. บังคับใช้ข้ามแดน ตั้งตัวแทนไม่จำกัดความรับผิด" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontFamily=Tahoma;strokeWidth=3;" edge="1" parent="1" source="CenterLaw" target="Foreign"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="8. ช่องทางร้องเรียน ระงับเนื้อหาอันตราย" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontFamily=Tahoma;" edge="1" parent="1" source="TechDev" target="User"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="9. ข้อตกลงต้องเป็นไปตามเกณฑ์คณะกรรมการ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontFamily=Tahoma;" edge="1" parent="1" source="TechDev" target="Seller"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="10. ร้องเรียนช่องทางกลาง / แจ้งเบาะแส" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontFamily=Tahoma;dashed=1;" edge="1" parent="1" source="User" target="Office"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="11. กำหนดนโยบายและกำกับการทำงาน" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontFamily=Tahoma;" edge="1" parent="1" source="Board" target="Office"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="12. เรียกเอกสาร เข้าถึงระบบ สั่งระงับชั่วคราว ปรับเป็นพินัย" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontFamily=Tahoma;dashed=1;" edge="1" parent="1" source="Office" target="TechDev"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="13. แจ้งประกอบธุรกิจ รายงานภายใน 60 วัน/รายปี" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontFamily=Tahoma;dashed=1;" edge="1" parent="1" source="TechDev" target="Office"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
