<mxfile host="app.diagrams.net"><diagram name="อินโฟกราฟิก 9x16" id="d1"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="1920" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="พรฎ.ยกเว้นรัษฎากร ฉบับที่ 808 พ.ศ. 2569 ราชกิจจาฯ 12 ต.ค. 2569 บังคับใช้ 13 ต.ค. 2569" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B2545;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="240" y="30" width="600" height="110" as="geometry" /></mxCell><mxCell id="c" value="ยกเว้นภาษีเงินได้นิติบุคคล 100% ของรายจ่ายจริง ลงทุนระบบ e-Tax Invoice / e-Receipt / ระบบนำส่งภาษี รายจ่าย 1 ม.ค. 2569 – 31 ธ.ค. 2570" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontSize=15;" vertex="1" parent="1"><mxGeometry x="190" y="210" width="700" height="130" as="geometry" /></mxCell><mxCell id="o" value="ฉบับเดิม พรฎ.766/2566: รายจ่ายถึง 31 ธ.ค. 2568, ไม่มีรายการค่าตรวจประเมินระบบ, นิยามผู้ให้บริการแยกจัดทำ/นำส่ง" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontColor=#4B5563;fontSize=15;" vertex="1" parent="1"><mxGeometry x="60" y="420" width="440" height="150" as="geometry" /></mxCell><mxCell id="n" value="ฉบับใหม่ พรฎ.808/2569: ต่อเวลาถึง 31 ธ.ค. 2570, เพิ่มค่าตรวจประเมินระบบที่จ่าย สพธอ., รวมนิยามผู้ให้บริการ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2F6;strokeColor=#0B2545;fontColor=#0B2545;fontSize=15;" vertex="1" parent="1"><mxGeometry x="580" y="420" width="440" height="150" as="geometry" /></mxCell><mxCell id="tc" value="บริษัท / ห้างหุ้นส่วนนิติบุคคลที่ลงทุนระบบ e-Tax" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B2545;strokeColor=#0B2545;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="60" y="660" width="440" height="100" as="geometry" /></mxCell><mxCell id="pv" value="ผู้ให้บริการจัดทำ/นำส่งข้อมูล ผู้ให้บริการคลาวด์" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF6600;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="580" y="660" width="440" height="100" as="geometry" /></mxCell><mxCell id="rd" value="กรมสรรพากร อธิบดีออกประกาศหลักเกณฑ์" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontColor=#4B5563;fontSize=15;" vertex="1" parent="1"><mxGeometry x="580" y="850" width="440" height="90" as="geometry" /></mxCell><mxCell id="pn" value="ไม่มีโทษปรับในตัวพระราชกฤษฎีกา สิทธิใช้ได้เมื่อทรัพย์สินครบเงื่อนไขมาตรา 6 เช่น ใช้งานไม่น้อยกว่า 3 รอบบัญชี" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;fontColor=#991B1B;fontSize=15;" vertex="1" parent="1"><mxGeometry x="190" y="1050" width="700" height="130" as="geometry" /></mxCell><mxCell id="e0" value="ประกาศใช้อย่างเป็นทางการ" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="t" target="c"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="ต่อเนื่องจากมาตรการเดิมที่สิ้นสุด 2568" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c" target="o"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="ขยายเวลาและเพิ่มรายการรายจ่าย" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c" target="n"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="1. ให้สิทธิยกเว้นภาษีตามรายจ่ายจริง" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n" target="tc"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="2. ซื้อบริการจัดทำ นำส่ง และเก็บใบกำกับ" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tc" target="pv"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="3. ออกเอกสารอิเล็กทรอนิกส์ที่เชื่อมระบบกรมสรรพากร" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pv" target="rd"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="4. ประกาศหลักเกณฑ์ วิธีการ เงื่อนไขการใช้สิทธิ" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="rd" target="tc"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="หากทรัพย์สินไม่เข้าเงื่อนไข" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="tc" target="pn"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" value="สิทธิเดิมสิ้นสุดแล้วตามช่วงเวลา" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="o" target="pn"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>