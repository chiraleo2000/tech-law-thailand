<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram name="อินโฟกราฟิก 9x16" id="d1">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="1920" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n_title" value="ประกาศ ธปท. ที่ 44/2569 บริหารความเสี่ยงร้านค้ารับชำระเงิน ราชกิจจาฯ 7 ต.ค. 2569 · มีผล 8 ต.ค. 2569" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B2545;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240" y="30" width="600" height="120" as="geometry" /></mxCell>
        <mxCell id="n_core" value="💡 สาระสำคัญ ผู้ให้บริการรับชำระเงินต้องจัดระดับความเสี่ยงร้านค้า รู้จักร้านค้าก่อนรับ ตรวจจับความผิดปกติ และคุมร้านค้าหลักตลอดวงจร" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontSize=14;" vertex="1" parent="1"><mxGeometry x="190" y="230" width="700" height="130" as="geometry" /></mxCell>
        <mxCell id="n_old" value="แนวนโยบาย KYM ปี 2564 • เน้นรู้จักร้านค้า • ไม่มีการแบ่งระดับในประกาศ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontColor=#4B5563;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="450" width="420" height="170" as="geometry" /></mxCell>
        <mxCell id="n_new" value="ประกาศ 44/2569 • ร้านค้า 3 ระดับ • ใช้ CFR และรายชื่อบัญชีม้า • คุมร้านค้าหลักและ sub-merchant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2F6;strokeColor=#0B2545;fontColor=#0B2545;fontSize=13;" vertex="1" parent="1"><mxGeometry x="600" y="450" width="420" height="170" as="geometry" /></mxCell>
        <mxCell id="n_tech" value="🏢 ผู้ให้บริการรับชำระเงิน และ e-Money" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B2545;strokeColor=#0B2545;fontColor=#FFFFFF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="740" width="420" height="120" as="geometry" /></mxCell>
        <mxCell id="n_user" value="👤 ร้านค้า ผู้ซื้อ และประชาชน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF6600;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="600" y="740" width="420" height="120" as="geometry" /></mxCell>
        <mxCell id="n_pen" value="⚠️ ไม่มีโทษโดยตรงในประกาศ แต่ต้องเปิดเผยหากถูกปรับทางปกครอง เปลี่ยนผ่าน 90 วัน และ 1 ปี สำหรับร้านค้าเดิม" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;fontColor=#991B1B;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="140" y="1010" width="800" height="140" as="geometry" /></mxCell>
        <mxCell id="e0" value="ออกตามอำนาจ ม.24-26 พ.ร.บ.ระบบการชำระเงิน" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;html=1;fontSize=11;strokeColor=#0B2545;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n_title" target="n_core"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e1" value="แทนที่แนวนโยบาย KYM และหนังสือเวียนเดิม" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;html=1;fontSize=11;strokeColor=#0B2545;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n_core" target="n_old"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="ยกระดับเป็นการบริหารความเสี่ยงตลอดวงจร" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;html=1;fontSize=11;strokeColor=#0B2545;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n_core" target="n_new"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="1. ต้องมีนโยบาย ระบบตรวจจับ และ watch list" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;html=1;fontSize=11;strokeColor=#0B2545;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n_new" target="n_tech"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="2. ถูกตรวจสอบก่อนรับ และมีสิทธิขอแก้ไขเมื่อไม่เกี่ยวข้อง" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;html=1;fontSize=11;strokeColor=#0B2545;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n_new" target="n_user"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="3. กำหนดวงเงิน ชะลอโอน หรือระงับบริการเมื่อน่าสงสัย" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;html=1;fontSize=11;strokeColor=#0B2545;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n_tech" target="n_user"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="4. ได้รับความคุ้มครองจากร้านค้าหลอกลวงลดลง" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;html=1;fontSize=11;strokeColor=#0B2545;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n_user" target="n_tech"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="หากปฏิบัติไม่ได้ ขอผ่อนผันต่อ ธปท." style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;html=1;fontSize=11;dashed=1;strokeColor=#0B2545;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n_tech" target="n_pen"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="ถูกแทนที่หรือยกระดับโดยกฎใหม่ ตามสถานะการบังคับใช้" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;html=1;fontSize=11;dashed=1;strokeColor=#0B2545;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n_old" target="n_pen"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
