<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram name="อินโฟกราฟิก 9x16" id="d1">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="1920" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n_title" value="ประกาศ ธปท. ที่ 45/2569 การขออนุญาตให้บริการเครื่อง WSM ราชกิจจาฯ 7 ต.ค. 2569" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B2545;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240" y="30" width="600" height="120" as="geometry" /></mxCell>
        <mxCell id="n_core" value="💡 สาระสำคัญ ผู้ให้บริการเครื่อง White-label Smart Machine ต้องขอใบอนุญาต ทุนไม่ต่ำกว่า 100 ล้านบาท ประสบการณ์ 10 ปี และผ่านการประเมินความพร้อมก่อนยื่น" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontSize=14;" vertex="1" parent="1"><mxGeometry x="190" y="230" width="700" height="130" as="geometry" /></mxCell>
        <mxCell id="n_old" value="ก่อนหน้านี้ • ยังไม่มีใบอนุญาตเฉพาะ • ไม่มีเกณฑ์ทุนและประสบการณ์" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontColor=#4B5563;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="450" width="420" height="170" as="geometry" /></mxCell>
        <mxCell id="n_new" value="ประกาศ 45/2569 • ทุน 100 ล้านบาท • ประสบการณ์ 10 ปี • ส่งแผนใน 180 วัน • ธปท. พิจารณาใน 60 วันทำการ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2F6;strokeColor=#0B2545;fontColor=#0B2545;fontSize=13;" vertex="1" parent="1"><mxGeometry x="600" y="450" width="420" height="170" as="geometry" /></mxCell>
        <mxCell id="n_tech" value="🏢 ผู้ประสงค์จะให้บริการ เครื่อง WSM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B2545;strokeColor=#0B2545;fontColor=#FFFFFF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="740" width="420" height="120" as="geometry" /></mxCell>
        <mxCell id="n_user" value="👤 ประชาชนและ ผู้ใช้เงินสด" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF6600;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="600" y="740" width="420" height="120" as="geometry" /></mxCell>
        <mxCell id="n_pen" value="⚠️ ไม่มีโทษปรับโดยตรง แต่ธปท.สั่งแก้ไข ระงับ หรือเสนอเพิกถอนใบอนุญาตได้ ต้องส่งแผนภายใน 180 วัน มิฉะนั้นยื่นขอไม่ได้" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;fontColor=#991B1B;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="140" y="1010" width="800" height="140" as="geometry" /></mxCell>
        <mxCell id="e0" value="ออกต่อเนื่องจากประกาศกระทรวงการคลัง ฉบับที่ 2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;html=1;fontSize=11;strokeColor=#0B2545;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n_title" target="n_core"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e1" value="กำหนดกรอบการขออนุญาตใหม่ทั้งระบบ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;html=1;fontSize=11;strokeColor=#0B2545;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n_core" target="n_old"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="ยกระดับเป็นบริการที่ต้องมีใบอนุญาต" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;html=1;fontSize=11;strokeColor=#0B2545;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n_core" target="n_new"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="1. ต้องผ่านเกณฑ์ทุน ประสบการณ์ และประเมินความพร้อม" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;html=1;fontSize=11;strokeColor=#0B2545;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n_new" target="n_tech"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="2. ได้ใช้เครื่องเงินสดร่วมกันหลายธนาคาร" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;html=1;fontSize=11;strokeColor=#0B2545;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n_new" target="n_user"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="3. หารือธนาคารและส่งแผนบริหารเครื่อง" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;html=1;fontSize=11;strokeColor=#0B2545;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n_tech" target="n_user"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="4. ได้บริการเงินสดทั่วถึงขึ้นโดยเฉพาะพื้นที่ห่างไกล" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;html=1;fontSize=11;strokeColor=#0B2545;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n_user" target="n_tech"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="เพิกถอนหรือระงับหากข้อมูลไม่ตรงจริง" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;html=1;fontSize=11;dashed=1;strokeColor=#0B2545;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n_tech" target="n_pen"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="ถูกแทนที่หรือยกระดับโดยกฎใหม่ ตามสถานะการบังคับใช้" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;html=1;fontSize=11;dashed=1;strokeColor=#0B2545;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n_old" target="n_pen"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
