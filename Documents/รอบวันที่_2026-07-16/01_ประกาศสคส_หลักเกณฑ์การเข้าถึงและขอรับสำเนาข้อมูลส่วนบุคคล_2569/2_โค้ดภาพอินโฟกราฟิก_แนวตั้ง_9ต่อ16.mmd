%% โค้ดต้นฉบับ: 2_โค้ดภาพอินโฟกราฟิก_แนวตั้ง_9ต่อ16.mmd
flowchart TD
    classDef headerClass fill:#0B2545,stroke:#FF6600,stroke-width:3px,color:#FFFFFF,font-size:26px,font-weight:bold;
    classDef essenceClass fill:#FFF5EB,stroke:#FF6600,stroke-width:2px,color:#111827,font-size:23px;
    classDef oldLawClass fill:#F3F4F6,stroke:#9CA3AF,stroke-width:1px,color:#4B5563,font-size:22px;
    classDef newLawClass fill:#EEF2F6,stroke:#0B2545,stroke-width:2px,color:#0B2545,font-size:22px;
    classDef techSide fill:#0B2545,stroke:#0B2545,stroke-width:2px,color:#FFFFFF,font-size:22px;
    classDef userSide fill:#FF6600,stroke:#FF6600,stroke-width:2px,color:#FFFFFF,font-size:22px;
    classDef penaltyClass fill:#FEF2F2,stroke:#EF4444,stroke-width:2px,color:#991B1B,font-size:22px,font-weight:bold;

    subgraph HEADER ["📢 สรุปกฎหมายไอทีฉบับใหม่"]
        TitleNode["📜 หลักเกณฑ์การเข้าถึงและขอรับสำเนาข้อมูลส่วนบุคคล พ.ศ. 2569 (สคส.)<br/>มีผลบังคับใช้: 14 ก.ย. 2569"]:::headerClass
    end
    subgraph CORE ["💡 สาระสำคัญที่ต้องรู้"]
        CoreEssence["ขั้นตอนกลางของสิทธิขอเข้าถึงและขอสำเนาข้อมูลส่วนบุคคล (DSAR) ตามมาตรา 30 PDPA"]:::essenceClass
    end
    subgraph COMPARISON ["⚖️ เปรียบเทียบจุดเปลี่ยนสำคัญ (เดิม vs ใหม่)"]
        OldRule["🏛️ เดิม<br/>• มีแค่สิทธิตามมาตรา 30<br/>• ไม่มีขั้นตอน/ค่าธรรมเนียมกลาง"]:::oldLawClass
        NewRule["🚀 ใหม่<br/>• ตรวจคำขอ ≤15 วัน ตอบ ≤30 วัน<br/>• ฟรีถ้าให้ทางอิเล็กทรอนิกส์<br/>• เก็บบันทึก ≥2 ปี"]:::newLawClass
    end
    subgraph STAKEHOLDERS ["👥 ผู้เกี่ยวข้องและหน้าที่"]
        TechCompany["🏢 ผู้ควบคุมข้อมูลส่วนบุคคล / บริษัทไอที"]:::techSide
        EndUser["👤 เจ้าของข้อมูลส่วนบุคคล / ประชาชน"]:::userSide
    end
    subgraph FOOTER ["⚠️ บทกำหนดโทษและการบังคับใช้"]
        PenaltyNode["🚨 ไม่ปฏิบัติตามคำขอตามมาตรา 30 PDPA ปรับทางปกครองไม่เกิน 1 ล้านบาท (มาตรา 82)<br/>แหล่งอ้างอิง: www.pdpc.or.th"]:::penaltyClass
    end

    TitleNode -->|"ประกาศใช้อย่างเป็นทางการ"| CoreEssence
