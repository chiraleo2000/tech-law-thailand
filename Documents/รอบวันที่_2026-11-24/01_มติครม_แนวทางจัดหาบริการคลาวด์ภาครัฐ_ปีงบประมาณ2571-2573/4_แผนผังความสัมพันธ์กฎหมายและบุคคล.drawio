<mxfile host="thai-tech-law-pipeline"><diagram name="หน้า-1"><mxGraphModel dx="1920" dy="1080" grid="1" gridSize="10" pageWidth="1920" pageHeight="1080" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="CenterLaw" value="📜 แนวทางจัดหาคลาวด์ภาครัฐ ปีงบ 2571–2573 (National Cloud)&lt;br/&gt;(ศูนย์กลางการบังคับใช้)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B2545;strokeColor=#FF6600;fontColor=#FFFFFF;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="440" height="170" as="geometry"/></mxCell><mxCell id="DGLaw" value="พ.ร.บ.บริหารงานภาครัฐผ่านระบบดิจิทัล 2562&lt;br/&gt;+ นโยบาย Cloud First" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="500" y="40" width="440" height="170" as="geometry"/></mxCell><mxCell id="Cyber" value="พ.ร.บ.ไซเบอร์ 2562 + มาตรฐานคลาวด์ กมช. 2567" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="960" y="40" width="440" height="170" as="geometry"/></mxCell><mxCell id="PDPA" value="พ.ร.บ.คุ้มครองข้อมูลส่วนบุคคล 2562" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="1420" y="40" width="440" height="170" as="geometry"/></mxCell><mxCell id="Proc" value="พ.ร.บ.จัดซื้อจัดจ้างฯ 2560" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="440" height="170" as="geometry"/></mxCell><mxCell id="Agency" value="หน่วยงานของรัฐผู้ขอรับงบประมาณ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="500" y="260" width="440" height="170" as="geometry"/></mxCell><mxCell id="CSP" value="