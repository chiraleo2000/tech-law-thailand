<mxfile host="thai-tech-law-pipeline"><diagram name="หน้า-1"><mxGraphModel dx="1920" dy="1080" grid="1" gridSize="10" pageWidth="1920" pageHeight="1080" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="CenterLaw" value="📜 (ร่าง) เปิดทาง Non-Bank และ ธปท. ให้บริการ e-Withholding Tax&lt;br/&gt;(ศูนย์กลางการบังคับใช้)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B2545;strokeColor=#FF6600;fontColor=#FFFFFF;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="440" height="170" as="geometry"/></mxCell><mxCell id="RevCode" value="ประมวลรัษฎากร ม.3 ปัณรส&lt;br/&gt;+ กฎกระทรวง 364 (2563)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="500" y="40" width="440" height="170" as="geometry"/></mxCell><mxCell id="PSA" value="พ.ร.บ.ระบบการชำระเงิน 2560" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="960" y="40" width="440" height="170" as="geometry"/></mxCell><mxCell id="Rate" value="กฎกระทรวง 402 (2569) + คำสั่ง ท.ป. 371/2569" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="1420" y="40" width="440" height="170" as="geometry"/></mxCell><mxCell id="PDPA" value="PDPA 2562 + พ.ร.บ.ธุรกรรมฯ 2544" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="440" height="170" as="geometry"/></mxCell><mxCell id="NonBank" value="Non-Bank ผู้ให้บริการโอนเงินอิเล็กทรอนิกส์" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="500" y="260" width="440" height="170" as="geometry"/></mxCell><mxCell id="BOT" value="ธปท. (นายทะเบียนพันธบัตร/ผู้จ่ายเงิน)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="960" y="260" width="440" height="170" as="geometry"/></mxCell><mxCell id="Payer" value="ผู้ประกอบการผู้จ่าย / ผู้รับเงิน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="1420" y="260" width="440" height="170" as="geometry"/></mxCell><mxCell id="Reg" value="กรมสรรพากร • กระทรวงการคลัง • ธปท. (ผู้กำกับ Non-Bank)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="440" height="170" as="geometry"/></mxCell><mxCell id="e0" value="1. แก้นิยามและเพิ่มช่องทางนำส่ง" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontFamily=Tahoma;" edge="1" parent="1" source="CenterLaw" target="RevCode"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="2. ใช้ใบอนุญาตโอนเงินอิเล็กทรอนิกส์เป็นเกณฑ์" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontFamily=Tahoma;" edge="1" parent="1" source="CenterLaw" target="PSA"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="3. อัตราหัก 1% เมื่อนำส่งทางอิเล็กทรอนิกส์" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontFamily=Tahoma;" edge="1" parent="1" source="CenterLaw" target="Rate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="4. คุ้มครองข้อมูลผู้รับเงิน/หลักฐานอิเล็กทรอนิกส์" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontFamily=Tahoma;" edge="1" parent="1" source="CenterLaw" target="PDPA"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="5. ส่งข้อมูล+เงินภาษี แยกบัญชีเงินรับล่วงหน้า" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontFamily=Tahoma;" edge="1" parent="1" source="CenterLaw" target="NonBank"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="6. นำส่ง WHT/VAT ผ่านระบบสรรพากร" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontFamily=Tahoma;" edge="1" parent="1" source="CenterLaw" target="BOT"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="7. นำส่งภาษีพร้อมโอน ไม่ต้องเก็บ 50 ทวิ" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontFamily=Tahoma;" edge="1" parent="1" source="NonBank" target="Payer"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="9. ใช้สิทธิ/ร้องขอข้อมูลและแจ้งปัญหา" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontFamily=Tahoma;" edge="1" parent="1" source="Payer" target="NonBank"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="10. ให้บริการโครงสร้างพื้นฐานรองรับ" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontFamily=Tahoma;" edge="1" parent="1" source="BOT" target="NonBank"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="11. รายงาน/ขออนุมัติตามรอบ" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontFamily=Tahoma;" edge="1" parent="1" source="NonBank" target="Reg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="8. อนุญาต ออกประกาศอธิบดี ตรวจสอบ" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontFamily=Tahoma;" edge="1" parent="1" source="Reg" target="NonBank"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="12. ร้องเรียนเมื่อถูกละเมิดสิทธิ" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontFamily=Tahoma;" edge="1" parent="1" source="Payer" target="Reg"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
