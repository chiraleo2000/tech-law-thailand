<mxfile host="app.diagrams.net"><diagram name="แผนผังความสัมพันธ์"><mxGraphModel dx="1920" dy="1080" grid="1" gridSize="10" pageWidth="1920" pageHeight="1080" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="CL" value="พ.ร.ฎ. เปิดเผยข้อมูลข่าวสารส่วนบุคคลระหว่างหน่วยงานของรัฐ พ.ศ. 2569" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B2545;strokeColor=#FF6600;fontColor=#FFFFFF;fontFamily=Loma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="760" y="420" width="340" height="110" as="geometry"/></mxCell><mxCell id="OIA" value="พ.ร.บ.ข้อมูลข่าวสารของราชการ 2540 ม.24 (9)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#0B2545;fontColor=#0B2545;fontFamily=Loma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="340" height="110" as="geometry"/></mxCell><mxCell id="PDPA" value="PDPA พ.ศ. 2562" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#0B2545;fontColor=#0B2545;fontFamily=Loma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="240" width="340" height="110" as="geometry"/></mxCell><mxCell id="CY" value="พ.ร.บ.ไซเบอร์ 2562 + มาตรฐาน กมช./สกมช." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#0B2545;fontColor=#0B2545;fontFamily=Loma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="420" width="340" height="110" as="geometry"/></mxCell><mxCell id="DG" value="พ.ร.บ.รัฐบาลดิจิทัล 2562 + ระเบียบแบ่งปันข้อมูลดิจิทัล 2569" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#0B2545;fontColor=#0B2545;fontFamily=Loma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="600" width="340" height="110" as="geometry"/></mxCell><mxCell id="H" value="หน่วยงานรัฐผู้ถือข้อมูล" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontFamily=Loma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1260" y="160" width="340" height="110" as="geometry"/></mxCell><mxCell id="RQ" value="หน่วยง