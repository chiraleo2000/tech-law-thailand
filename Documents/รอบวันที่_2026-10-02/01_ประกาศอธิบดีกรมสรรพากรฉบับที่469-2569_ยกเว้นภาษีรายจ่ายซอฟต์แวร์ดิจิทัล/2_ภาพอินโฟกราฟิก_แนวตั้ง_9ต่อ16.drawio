<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net"><diagram name="อินโฟกราฟิก 9x16" id="d1"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="1920" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="TitleNode" value="📜 ประกาศอธิบดีกรมสรรพากร ฉบับที่ 469&lt;br/&gt;ประกาศ 30 ก.ย. 2569 · ลงเว็บ 2 ต.ค. 2569&lt;br/&gt;ใช้กับรายจ่ายตั้งแต่ 24 มิ.ย. 2568" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B2545;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="460" height="130" as="geometry"/></mxCell><mxCell id="CoreEssence" value="💡 SMEs ยกเว้นภาษีนิติบุคคล 100% ของค่าซอฟต์แวร์&lt;br/&gt;ฮาร์ดแวร์ อุปกรณ์อัจฉริยะ และบริการดิจิทัล&lt;br/&gt;สูงสุด 300,000 บาทต่อรอบบัญชี ถึง 31 ธ.ค. 2570" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontSize=14;" vertex="1" parent="1"><mxGeometry x="560" y="40" width="460" height="130" as="geometry"/></mxCell><mxCell id="OldRule" value="🏛️ มาตรการเดิม พ.ร.ฎ. 647/2560&lt;br/&gt;• เฉพาะโปรแกรมคอมพิวเตอร์&lt;br/&gt;• ยกเว้นสูงสุด 100,000 บาท&lt;br/&gt;• ใช้ได้ถึงรอบบัญชี 2562" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontColor=#4B5563;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="460" height="130" as="geometry"/></mxCell><mxCell id="NewRule" value="🚀 ฉบับใหม่ พ.ร.ฎ. 802/2569 + ประกาศ 469&lt;br/&gt;• ซอฟต์แวร์ ฮาร์ดแวร์ อุปกรณ์อัจฉริยะ แพลตฟอร์ม&lt;br/&gt;• ยกเว้นสูงสุด 300,000 บาท&lt;br/&gt;• ต้องพัฒนาในไทย และผู้ขายขึ้นทะเบียน depa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2F6;strokeColor=#0B2545;fontColor=#0B2545;fontSize=14;" vertex="1" parent="1"><mxGeometry x="560" y="250" width="460" height="130" as="geometry"/></mxCell><mxCell id="TechCompany" value="🏢 ผู้ขายซอฟต์แวร์ / ผู้ให้บริการแพลตฟอร์ม&lt;br/&gt;ต้องขึ้นทะเบียนบัญชีบริการดิจิทัล depa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B2545;strokeColor=#0B2545;fontColor=#FFFFFF;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="460" height="130" as="geometry"/></mxCell><mxCell id="EndUser" value="👤 SMEs ผู้ซื้อ&lt;br/&gt;ทุนชำระแล้วไม่เกิน 5 ล้าน รายได้ไม่เกิน 30 ล้านบาท" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF6600;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=14;" vertex="1" parent="1"><mxGeometry x="560" y="460" width="460" height="130" as="geometry"/></mxCell><mxCell id="RD" value="🏛️ กรมสรรพากร&lt;br/&gt;เจ้าพนักงานประเมินตรวจรายงาน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontColor=#4B5563;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="670" width="460" height="130" as="geometry"/></mxCell><mxCell id="PenaltyNode" value="⚠️ ไม่มีโทษในตัวประกาศ&lt;br/&gt;แต่ไม่เข้าเงื่อนไขหรือไม่มีรายงาน&lt;br/&gt;เสี่ยงเสียสิทธิยกเว้นภาษี" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;fontColor=#991B1B;fontSize=14;" vertex="1" parent="1"><mxGeometry x="560" y="670" width="460" height="130" as="geometry"/></mxCell><mxCell id="e0" value="ประกาศใช้อย่างเป็นทางการ" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=12;" edge="1" parent="1" source="TitleNode" target="CoreEssence"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="ขยายจากมาตรการเดิมที่สิ้นสุดแล้ว" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=12;" edge="1" parent="1" source="CoreEssence" target="OldRule"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="กำหนดวงเงินและเงื่อนไขใหม่" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=12;" edge="1" parent="1" source="CoreEssence" target="NewRule"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="1. ผู้ขายต้องขึ้นทะเบียนก่อนขาย" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=12;" edge="1" parent="1" source="NewRule" target="TechCompany"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="2. ส่งมอบซอฟต์แวร์และบริการที่พัฒนาในไทย" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=12;" edge="1" parent="1" source="TechCompany" target="EndUser"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="3. จัดทำรายงานการใช้สิทธิเก็บไว้ที่สถานประกอบการ" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=12;" edge="1" parent="1" source="EndUser" target="RD"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="4. ตรวจสอบและยอมรับสิทธิยกเว้นภาษี" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=12;" edge="1" parent="1" source="RD" target="EndUser"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="หากไม่เข้าเงื่อนไข" style="endArrow=classic;html=1;dashed=1;strokeColor=#0B2545;fontSize=12;" edge="1" parent="1" source="EndUser" target="PenaltyNode"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="วงเงินเดิมต่ำกว่าและสิ้นสุดแล้ว" style="endArrow=classic;html=1;dashed=1;strokeColor=#0B2545;fontSize=12;" edge="1" parent="1" source="OldRule" target="PenaltyNode"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>