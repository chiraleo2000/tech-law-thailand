<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net"><diagram name="แผนผังความสัมพันธ์" id="d1"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="CenterLaw" value="📜 ประกาศอธิบดีกรมสรรพากร ฉบับที่ 469&lt;br/&gt;ยกเว้นภาษีรายจ่ายซอฟต์แวร์และบริการดิจิทัล&lt;br/&gt;(ศูนย์กลางการบังคับใช้)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B2545;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="360" height="110" as="geometry"/></mxCell><mxCell id="Decree" value="พ.ร.ฎ. ยกเว้นรัษฎากร ฉบับที่ 802&lt;br/&gt;พ.ศ. 2569 (กฎหมายแม่)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#0B2545;fontColor=#0B2545;fontSize=14;" vertex="1" parent="1"><mxGeometry x="460" y="40" width="360" height="110" as="geometry"/></mxCell><mxCell id="RevCode" value="ประมวลรัษฎากร&lt;br/&gt;มาตรา 3 (1) และ 65 ทวิ (2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#0B2545;fontColor=#0B2545;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="40" width="360" height="110" as="geometry"/></mxCell><mxCell id="BOI" value="กฎหมายส่งเสริมการลงทุน&lt;br/&gt;EEC และอุตสาหกรรมเป้าหมาย" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#0B2545;fontColor=#0B2545;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="360" height="110" as="geometry"/></mxCell><mxCell id="PDPA" value="PDPA พ.ศ. 2562&lt;br/&gt;(ข้อสังเกตเชิงปฏิบัติ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#0B2545;fontColor=#0B2545;fontSize=14;" vertex="1" parent="1"><mxGeometry x="460" y="230" width="360" height="110" as="geometry"/></mxCell><mxCell id="TechDev" value="ผู้พัฒนาซอฟต์แวร์ / ผู้ให้บริการแพลตฟอร์มในไทย" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="230" width="360" height="110" as="geometry"/></mxCell><mxCell id="Depa" value="สำนักงานส่งเสริมเศรษฐกิจดิจิทัล (depa)&lt;br/&gt;บัญชีบริการดิจิทัล" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="360" height="110" as="geometry"/></mxCell><mxCell id="SME" value="บริษัท/ห้างหุ้นส่วนนิติบุคคล SMEs&lt;br/&gt;ผู้ซื้อและใช้บริการ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;fontColor=#166534;fontSize=14;" vertex="1" parent="1"><mxGeometry x="460" y="420" width="360" height="110" as="geometry"/></mxCell><mxCell id="RD" value="กรมสรรพากร&lt;br/&gt;เจ้าพนักงานประเมิน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;fontColor=#991B1B;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="420" width="360" height="110" as="geometry"/></mxCell><mxCell id="e0" value="1. ออกตามอำนาจมาตรา 4 ของ" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=12;" edge="1" parent="1" source="CenterLaw" target="Decree"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="2. ตราตามมาตรา 3 (1) ของ" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=12;" edge="1" parent="1" source="Decree" target="RevCode"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="3. อ้างหลักการหักค่าเสื่อมราคา" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=12;" edge="1" parent="1" source="CenterLaw" target="RevCode"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="4. ห้ามใช้สิทธิซ้อนกับ" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=12;" edge="1" parent="1" source="Decree" target="BOI"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="5. กำหนดเงื่อนไขผู้ขายต้องขึ้นทะเบียน" style="endArrow=classic;html=1;strokeWidth=3;strokeColor=#0B2545;fontSize=12;" edge="1" parent="1" source="CenterLaw" target="TechDev"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="6. ขอขึ้นทะเบียนสินค้าและบริการ" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=12;" edge="1" parent="1" source="TechDev" target="Depa"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="7. อนุมัติขึ้นทะเบียนก่อนการซื้อ" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=12;" edge="1" parent="1" source="Depa" target="TechDev"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="8. ขายซอฟต์แวร์และบริการที่พัฒนาในไทย" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=12;" edge="1" parent="1" source="TechDev" target="SME"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="9. ตรวจสัญญาผู้ประมวลผลข้อมูลตาม" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=12;" edge="1" parent="1" source="SME" target="PDPA"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="10. เก็บรายงานการใช้สิทธิให้ตรวจสอบ" style="endArrow=classic;html=1;dashed=1;strokeColor=#0B2545;fontSize=12;" edge="1" parent="1" source="SME" target="RD"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="11. ตรวจสอบและยอมรับสิทธิยกเว้นภาษี" style="endArrow=classic;html=1;dashed=1;strokeColor=#0B2545;fontSize=12;" edge="1" parent="1" source="RD" target="SME"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>