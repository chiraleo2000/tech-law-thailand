<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram name="อินโฟกราฟิก 9x16" id="d1">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="1920" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="TitleNode" value="📜 มาตรฐานความมั่นคงปลอดภัยสำหรับเว็บไซต์ พ.ศ. 2568 (WSS 1.0)&#10;มีผลบังคับใช้: 16 ก.ย. 2569" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B2545;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=14;fontStyle=1;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="240" y="40" width="600" height="120" as="geometry" /></mxCell>
        <mxCell id="CoreEssence" value="เว็บไซต์ภาครัฐและ CII ต้องปฏิบัติตามข้อกำหนดขั้นต่ำตามระดับผลกระทบ และประเมินตนเองทุกปี" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontSize=13;" vertex="1" parent="1"><mxGeometry x="240" y="260" width="600" height="120" as="geometry" /></mxCell>
        <mxCell id="OldRule" value="🏛️ เดิม&#10;• มีแค่แนวปฏิบัติไม่บังคับ&#10;• เว็บรัฐถูกแฮ็ก/ฝังพนันบ่อย" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontColor=#4B5563;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="520" width="420" height="180" as="geometry" /></mxCell>
        <mxCell id="NewRule" value="🚀 ใหม่&#10;• บังคับรัฐ/CII ตามระดับผลกระทบ&#10;• NIST CSF 2.0 6 ฟังก์ชัน&#10;• ประเมินตนเอง ค1/ค2 ปีละครั้ง" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2F6;strokeColor=#0B2545;fontColor=#0B2545;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="520" width="420" height="180" as="geometry" /></mxCell>
        <mxCell id="TechCompany" value="🏢 ผู้พัฒนาเว็บ / Web Hosting / ทีมไอทีหน่วยงาน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B2545;strokeColor=#0B2545;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="900" width="420" height="120" as="geometry" /></mxCell>
        <mxCell id="EndUser" value="👤 ประชาชนผู้ใช้เว็บไซต์รัฐ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF6600;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="900" width="420" height="120" as="geometry" /></mxCell>
        <mxCell id="PenaltyNode" value="🚨 ไม่มีโทษใหม่ CII ที่ไม่ได้มาตรฐานเข้ากลไกมาตรา 53-54 พ.ร.บ.ไซเบอร์&#10;แหล่งอ้างอิง: drive.ncsa.or.th" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;fontColor=#991B1B;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="160" y="1300" width="760" height="160" as="geometry" /></mxCell>
        <mxCell id="e0" value="ประกาศใช้อย่างเป็นทางการ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="TitleNode" target="CoreEssence"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e1" value="ปิดช่องว่างของแนวปฏิบัติเดิม" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="CoreEssence" target="OldRule"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="กำหนดข้อกำหนดขั้นต่ำฉบับใหม่" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="CoreEssence" target="NewRule"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="1. กำหนดหน้าที่ต้องปฏิบัติและเก็บหลักฐาน" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="NewRule" target="TechCompany"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="2. ยกระดับความคุ้มครองข้อมูลและบริการ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="NewRule" target="EndUser"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="3. ส่งมอบบริการที่สอดคล้องมาตรฐาน" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="TechCompany" target="EndUser"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="4. ใช้สิทธิ/ร้องเรียนเมื่อพบปัญหา" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="EndUser" target="TechCompany"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="หากละเลยไม่ปฏิบัติตามเกณฑ์" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;dashed=1;" edge="1" parent="1" source="TechCompany" target="PenaltyNode"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="บทลงโทษอยู่ที่กฎหมายแม่" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;dashed=1;" edge="1" parent="1" source="OldRule" target="PenaltyNode"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
