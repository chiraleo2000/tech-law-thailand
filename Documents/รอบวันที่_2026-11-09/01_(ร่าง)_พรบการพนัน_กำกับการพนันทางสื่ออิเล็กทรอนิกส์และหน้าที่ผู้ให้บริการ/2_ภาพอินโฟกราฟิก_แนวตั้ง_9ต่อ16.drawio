<mxfile host="app.diagrams.net"><diagram name="อินโฟกราฟิก 9x16" id="d1"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="1920" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="TitleNode" value="📜 (ร่าง) พ.ร.บ.การพนัน พ.ศ. ....&#10;รับฟังความเห็น 9 พ.ย. – 9 ธ.ค. 2569&#10;ยังไม่มีผลใช้บังคับ" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#0B2545;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="140" y="60" width="800" height="150" as="geometry"/></mxCell><mxCell id="CoreEssence" value="ยกเลิกกฎหมายพนัน 2478&#10;เพิ่มหมวดพนันทางสื่ออิเล็กทรอนิกส์&#10;และหน้าที่ผู้ให้บริการดิจิทัล" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontSize=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="140" y="290" width="800" height="150" as="geometry"/></mxCell><mxCell id="OldRule" value="🏛️ พ.ร.บ. 2478&#10;• ไม่มีบทพนันออนไลน์&#10;• บัญชี ก / ข ท้าย พ.ร.บ.&#10;• โทษปรับต่ำ" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontColor=#4B5563;fontSize=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="520" width="440" height="150" as="geometry"/></mxCell><mxCell id="NewRule" value="🚀 ร่างใหม่&#10;• ปิดกั้นเว็บ/แอปภายใน 24 ชม.&#10;• รวมสินทรัพย์ดิจิทัล-e-Wallet&#10;• กฎกระทรวง 3 ระดับความเสี่ยง" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EEF2F6;strokeColor=#0B2545;fontColor=#0B2545;fontSize=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="540" y="520" width="440" height="150" as="geometry"/></mxCell><mxCell id="TechCompany" value="🏢 ISP / แพลตฟอร์ม / ระบบชำระเงิน&#10;/ ธุรกิจสินทรัพย์ดิจิทัล" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#0B2545;strokeColor=#0B2545;fontColor=#FFFFFF;fontSize=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="840" width="440" height="150" as="geometry"/></mxCell><mxCell id="EndUser" value="👤 ประชาชน / เยาวชนต่ำกว่า 20 ปี" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FF6600;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="540" y="840" width="440" height="150" as="geometry"/></mxCell><mxCell id="PenaltyNode" value="🚨 เจ้าของพนันออนไลน์: จำคุก 2–10 ปี ปรับสูงสุด 5 ล้าน หรือ 5 เท่ายอดหมุนเวียน&#10;ผู้ให้บริการไม่บล็อก: ปรับ ≤ 500,000 บาท + วันละ ≤ 20,000 บาท&#10;แหล่งอ้างอิง: law.go.th / กรมการปกครอง" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FEF2F2;strokeColor=#EF4444;fontColor=#991B1B;fontSize=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="1160" width="440" height="150" as="geometry"/></mxCell><mxCell id="e0" value="เปิดรับฟังผ่านระบบกลางทางกฎหมาย" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#0B2545;strokeWidth=2;fontSize=12;fontColor=#111827;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="TitleNode" target="CoreEssence"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="ยกเลิกทั้งฉบับพร้อมบัญชีท้าย" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#0B2545;strokeWidth=2;fontSize=12;fontColor=#111827;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="CoreEssence" target="OldRule"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="กำหนดกลไกกำกับดิจิทัลใหม่" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#0B2545;strokeWidth=2;fontSize=12;fontColor=#111827;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="CoreEssence" target="NewRule"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="1. ปิดกั้นตามคำสั่งศาล เก็บและส่งมอบข้อมูลจราจร" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#0B2545;strokeWidth=2;fontSize=12;fontColor=#111827;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="NewRule" target="TechCompany"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="2. คุ้มครองเยาวชน จำกัดวงเงิน Self-exclusion" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#0B2545;strokeWidth=2;fontSize=12;fontColor=#111827;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="NewRule" target="EndUser"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="3. ระงับบริการบัญชีและกระเป๋าเงินที่ใช้รับเดิมพัน" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#0B2545;strokeWidth=2;fontSize=12;fontColor=#111827;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="TechCompany" target="EndUser"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="4. แจ้งเบาะแสเว็บพนันและโฆษณาเถื่อน" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#0B2545;strokeWidth=2;fontSize=12;fontColor=#111827;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="EndUser" target="TechCompany"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="หากไม่ปิดกั้นตามคำสั่ง" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;dashed=1;strokeColor=#0B2545;strokeWidth=2;fontSize=12;fontColor=#111827;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="TechCompany" target="PenaltyNode"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="แทนที่อัตราโทษเดิมที่ต่ำ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;dashed=1;strokeColor=#0B2545;strokeWidth=2;fontSize=12;fontColor=#111827;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="OldRule" target="PenaltyNode"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>