<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram name="อินโฟกราฟิก 9x16" id="d1">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="1920" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="TitleNode" value="📜 (ร่าง) ประกาศ ก.ล.ต. กำกับธุรกรรม Stablecoin&#10;ผ่านผู้ประกอบธุรกิจสินทรัพย์ดิจิทัล (อนด. 82/2569)&#10;รับฟังความเห็น 11–26 พ.ย. 2569 · ยังไม่มีผล" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B2545;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=14;fontStyle=1;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="200" y="40" width="680" height="150" as="geometry" /></mxCell>
        <mxCell id="CoreEssence" value="สกัดการใช้ USDT/USDC ฟอกเงิน–เลี่ยงโอนเงินข้ามประเทศ&#10;ฝาก/ถอน Stablecoin ได้เฉพาะ wallet ของตัวเอง · ≤ 5 ล้านบาท/วัน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontSize=13;" vertex="1" parent="1"><mxGeometry x="200" y="270" width="680" height="130" as="geometry" /></mxCell>
        <mxCell id="OldRule" value="🏛️ เดิม (กธ. 19/2561)&#10;• ไม่มีนิยาม/เพดานโอน stablecoin&#10;• MM/LP คุมแค่คุณสมบัติ ไม่ต้องเปิดเผย&#10;• ซื้อขายนอกแพลตฟอร์มไม่มีเกณฑ์ขั้นต่ำ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontColor=#4B5563;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="460" height="200" as="geometry" /></mxCell>
        <mxCell id="NewRule" value="🚀 ใหม่ (ร่าง)&#10;• ห้ามโอนเข้า/ออกบัญชีผู้อื่น&#10;• เพดาน 5 ล้านบาท/วัน/คน/ผู้ประกอบการ&#10;• เปิดเผย MM/LP · นอกแพลตฟอร์ม ≥ 3 ล้านบาท&#10;• มีผล 60 วันหลังประกาศใช้" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2F6;strokeColor=#0B2545;fontColor=#0B2545;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="500" width="460" height="220" as="geometry" /></mxCell>
        <mxCell id="TechCompany" value="🏢 Exchange / Broker / Dealer สินทรัพย์ดิจิทัล" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B2545;strokeColor=#0B2545;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="460" height="120" as="geometry" /></mxCell>
        <mxCell id="EndUser" value="👤 นักลงทุนคริปโท / ผู้ใช้ Stablecoin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF6600;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="900" width="460" height="120" as="geometry" /></mxCell>
        <mxCell id="PenaltyNode" value="🚨 ไม่ปฏิบัติตาม: ก.ล.ต. สั่งแก้ไข/สั่งให้กระทำการภายในเวลา (ข้อ 7/1 ใหม่)&#10;+ บทลงโทษเดิมตาม พ.ร.ก.สินทรัพย์ดิจิทัล 2561&#10;แหล่งอ้างอิง: sec.or.th (อนด. 82/2569)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;fontColor=#991B1B;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="160" y="1300" width="760" height="170" as="geometry" /></mxCell>
        <mxCell id="e0" value="ก.ล.ต. เปิดรับฟังร่างประกาศ 2 ฉบับ (กธ./สธ.)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=12;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="TitleNode" target="CoreEssence"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e1" value="แก้ไขเพิ่มเติม ประกาศ กธ. 19/2561" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=12;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="CoreEssence" target="OldRule"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="เพิ่มข้อ 11/5–11/8, 39/3, 40/4–40/6, 41/1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=12;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="CoreEssence" target="NewRule"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="1. ยืนยัน wallet ลูกค้า + Travel Rule + จำกัดวงเงิน" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=12;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="NewRule" target="TechCompany"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="2. โอนได้เฉพาะบัญชีตนเอง ≤ 5 ล้านบาท/วัน" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=12;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="NewRule" target="EndUser"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="3. แจ้งเงื่อนไขก่อนให้บริการ + เปิดเผย MM/LP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=12;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="TechCompany" target="EndUser"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="4. ยืนยันตัวตน wallet และแหล่งที่มาของเงิน" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=12;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="EndUser" target="TechCompany"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="หากไม่ทำตาม/ไม่ส่งข้อมูล" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=12;labelBackgroundColor=#F8F9FA;dashed=1;" edge="1" parent="1" source="TechCompany" target="PenaltyNode"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="คงบทลงโทษเดิมตาม พ.ร.ก. 2561" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=12;labelBackgroundColor=#F8F9FA;dashed=1;" edge="1" parent="1" source="OldRule" target="PenaltyNode"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
