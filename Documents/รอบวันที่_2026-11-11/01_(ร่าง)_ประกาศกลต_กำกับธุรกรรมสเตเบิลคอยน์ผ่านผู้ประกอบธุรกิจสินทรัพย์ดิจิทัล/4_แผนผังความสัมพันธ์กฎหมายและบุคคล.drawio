<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram name="แผนผังความสัมพันธ์" id="d1">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="CenterLaw" value="📜 (ร่าง) ประกาศ ก.ล.ต. กำกับธุรกรรม Stablecoin&#10;ผ่านผู้ประกอบธุรกิจสินทรัพย์ดิจิทัล (อนด. 82/2569)&#10;(ศูนย์กลางการบังคับใช้)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B2545;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=14;fontStyle=1;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="760" y="440" width="420" height="160" as="geometry" /></mxCell>
        <mxCell id="L1" value="พ.ร.ก.การประกอบธุรกิจสินทรัพย์ดิจิทัล 2561&#10;+ ประกาศ กธ. 19/2561 / สธ. 17/2566" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#0B2545;fontColor=#0B2545;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="60" width="380" height="90" as="geometry" /></mxCell>
        <mxCell id="L2" value="พ.ร.บ.ป้องกันและปราบปรามการฟอกเงิน 2542&#10;(Travel Rule / STR ตามเกณฑ์ ปปง.)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#0B2545;fontColor=#0B2545;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="180" width="380" height="90" as="geometry" /></mxCell>
        <mxCell id="L3" value="พ.ร.ก.มาตรการป้องกันและปราบปราม&#10;อาชญากรรมทางเทคโนโลยี (บัญชีม้า)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#0B2545;fontColor=#0B2545;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="300" width="380" height="90" as="geometry" /></mxCell>
        <mxCell id="L4" value="PDPA 2562 + พ.ร.บ.ควบคุมการแลกเปลี่ยนเงิน&#10;(กำกับโดย ธปท.)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#0B2545;fontColor=#0B2545;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="420" width="380" height="90" as="geometry" /></mxCell>
        <mxCell id="TechDev" value="ศูนย์ซื้อขาย (DA Exchange) / Market Maker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1400" y="120" width="400" height="90" as="geometry" /></mxCell>
        <mxCell id="TechInfra" value="นายหน้า/ผู้ค้า (DA Broker / Dealer) / LP / ICO Portal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1400" y="260" width="400" height="90" as="geometry" /></mxCell>
        <mxCell id="User" value="นักลงทุนที่ฝาก–ถอน Stablecoin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;fontColor=#166534;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1400" y="560" width="400" height="90" as="geometry" /></mxCell>
        <mxCell id="Victim" value="ผู้เสียหายจากแก๊งมิจฉาชีพ / บัญชีม้า" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;fontColor=#166534;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1400" y="700" width="400" height="90" as="geometry" /></mxCell>
        <mxCell id="Regulator" value="ก.ล.ต. (ผู้ออกประกาศ) · ธปท. (Stablecoin ชำระเงิน/บาท) · ปปง." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;fontColor=#991B1B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="860" width="420" height="100" as="geometry" /></mxCell>
        <mxCell id="e0" value="1. แก้ไขเพิ่มเติมประกาศหลักของธุรกิจ DA" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=12;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="CenterLaw" target="L1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e1" value="2. ผูกการโอนกับ Travel Rule, EDD และรายงาน STR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=12;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="CenterLaw" target="L2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="3. คัดกรองบัญชีม้า/wallet ในบัญชีเฝ้าระวัง" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=12;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="CenterLaw" target="L3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="4. ประมวลผลข้อมูลยืนยันตัวตน wallet / ยกเว้นผู้ได้รับอนุญาต ธปท." style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=12;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="CenterLaw" target="L4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="5. เปิดเผยรายชื่อ MM + Due Diligence ต่อเนื่อง" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=12;labelBackgroundColor=#F8F9FA;strokeWidth=3;" edge="1" parent="1" source="CenterLaw" target="TechDev"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="6. ห้าม LP คู่ Stablecoin/บาท · นอกแพลตฟอร์ม ≥ 3 ล้าน" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=12;labelBackgroundColor=#F8F9FA;strokeWidth=3;" edge="1" parent="1" source="CenterLaw" target="TechInfra"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="7. จำกัดฝาก–ถอน ≤ 5 ล้านบาท/วัน และแจ้งเงื่อนไข" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=12;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="TechDev" target="User"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="8. ตัดเส้นทางโอนเงินผิดกฎหมายออกนอกประเทศ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=12;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="TechInfra" target="Victim"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="9. ยืนยัน wallet ของตนเองและแหล่งที่มาของรายได้" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=12;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="User" target="TechDev"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="10. ร้องขอระงับ/ติดตามเส้นทางสินทรัพย์" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=12;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="Victim" target="TechInfra"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" value="11. รายงานข้อมูลผ่าน e-reporting ตามรอบ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=12;labelBackgroundColor=#F8F9FA;dashed=1;" edge="1" parent="1" source="TechDev" target="Regulator"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" value="12. สั่งแก้ไข/สั่งให้กระทำการภายในเวลาที่กำหนด" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=12;labelBackgroundColor=#F8F9FA;dashed=1;" edge="1" parent="1" source="Regulator" target="TechInfra"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" value="13. ร้องเรียนต่อ ก.ล.ต. / แจ้งความผ่านระบบออนไลน์" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=12;labelBackgroundColor=#F8F9FA;dashed=1;" edge="1" parent="1" source="Victim" target="Regulator"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
