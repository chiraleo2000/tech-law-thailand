        <mxCell id="CenterLaw" value="📜 (ร่าง) ประกาศ กขค.&#10;โครงสร้างค่าบริการ + การจัดส่งสินค้า&#10;แพลตฟอร์ม E-commerce" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B2545;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=14;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="760" y="440" width="400" height="140" as="geometry" /></mxCell>
        <mxCell id="TCA" value="พ.ร.บ.การแข่งขันทางการค้า 2560&#10;(ม. 50 / 57 / 60)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#0B2545;fontColor=#0B2545;fontSize=12;fontStyle=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="380" height="110" as="geometry" /></mxCell>
