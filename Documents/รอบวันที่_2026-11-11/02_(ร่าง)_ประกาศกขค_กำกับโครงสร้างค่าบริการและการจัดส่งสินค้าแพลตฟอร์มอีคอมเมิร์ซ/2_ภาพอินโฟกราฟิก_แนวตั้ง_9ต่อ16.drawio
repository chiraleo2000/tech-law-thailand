<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram name="อินโฟกราฟิก 9x16" id="d1">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="1920" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="TitleNode" value="📜 (ร่าง) ประกาศ กขค. กำกับโครงสร้างค่าบริการ&#10;และการจัดส่งสินค้า แพลตฟอร์ม E-commerce&#10;รับฟังความเห็น 4 พ.ย.–3 ธ.ค. 2569 · ยังไม่มีผล" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B2545;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=14;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="200" y="40" width="680" height="150" as="geometry" /></mxCell>
        <mxCell id="CoreEssence" value="แพลตฟอร์มตลาดออนไลน์ที่มีอำนาจตลาดต้องขึ้นค่าธรรมเนียมอย่างโปร่งใส&#10;และให้ผู้ซื้อ–ร้านค้าเลือกบริษัทขนส่งได้จริง" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontSize=13;fontStyle=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="200" y="270" width="680" height="130" as="geometry" /></mxCell>
        <mxCell id="OldRule" value="🏛️ เดิม (แนวทาง กขค. E-Commerce 24 มี.ค. 69)&#10;• เป็นแนวทางพิจารณาพฤติกรรมต้องห้าม&#10;• ไม่มีระยะแจ้งขึ้นค่าธรรมเนียม&#10;• ไม่มีหน้าที่รายงาน/ตรวจอัลกอริทึม" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontColor=#4B5563;fontSize=12;fontStyle=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="460" height="220" as="geometry" /></mxCell>
        <mxCell id="NewRule" value="🚀 ใหม่ (ร่าง)&#10;• อำนาจตลาด: แจ้งขึ้นค่าธรรมเนียม ≥ 90 วัน&#10;• อำนาจเหนือตลาด: ขออนุญาต ≥ 180 วัน&#10;• เลือกขนส่งเสรี ห้าม Default/Dark pattern&#10;• Ring-fencing ข้อมูล · รายงานทุก 6 เดือน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2F6;strokeColor=#0B2545;fontColor=#0B2545;fontSize=12;fontStyle=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="580" y="500" width="460" height="220" as="geometry" /></mxCell>
        <mxCell id="TechCompany" value="🏢 แพลตฟอร์ม E-Marketplace (ส่วนแบ่ง ≥ 10%)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B2545;strokeColor=#0B2545;fontColor=#FFFFFF;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="460" height="120" as="geometry" /></mxCell>
        <mxCell id="EndUser" value="👤 ร้านค้าออนไลน์ / ผู้ซื้อ / ผู้ขนส่ง" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF6600;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="580" y="900" width="460" height="120" as="geometry" /></mxCell>
        <mxCell id="PenaltyNode" value="🚨 กขค. สั่งระงับการขึ้นค่าบริการ/มาตรการชั่วคราว ≤ 120 วัน&#10;สั่งแก้อัลกอริทึม · ตั้ง Trustee · โทษตาม พ.ร.บ.แข่งขัน 2560 (ม. 72/82)&#10;แหล่งอ้างอิง: tcct.or.th (หน้ารับฟังความคิดเห็น)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;fontColor=#991B1B;fontSize=12;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="140" y="1300" width="800" height="200" as="geometry" /></mxCell>
        <mxCell id="e0" value="สำนักงาน กขค. เปิดรับฟังร่างประกาศ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=11;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="TitleNode" target="CoreEssence"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e1" value="ต่อยอดแนวทาง E-Commerce มี.ค. 2569" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=11;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="CoreEssence" target="OldRule"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="เพิ่มหมวดค่าบริการ + หมวดขนส่ง (ข้อ 14–23)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=11;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="CoreEssence" target="NewRule"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="1. แจ้ง/ขออนุญาตขึ้นค่าธรรมเนียม + เปิดเกณฑ์ API ขนส่ง" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=11;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="NewRule" target="TechCompany"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="2. เลือกขนส่งเองได้ ไม่ถูกลดอันดับ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=11;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="NewRule" target="EndUser"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="3. แสดงค่าบริการแจกแจงได้ + ตัวเลือกขนส่งเป็นกลาง" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=11;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="TechCompany" target="EndUser"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="4. ร้องเรียน กขค. โดยได้รับการคุ้มครอง" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=11;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="EndUser" target="TechCompany"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="หากขึ้นค่าธรรมเนียม/Self-preferencing โดยมิชอบ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=11;labelBackgroundColor=#F8F9FA;dashed=1;" edge="1" parent="1" source="TechCompany" target="PenaltyNode"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="ยกระดับจากแนวทางสู่คำสั่งเชิงบังคับ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=11;labelBackgroundColor=#F8F9FA;dashed=1;" edge="1" parent="1" source="OldRule" target="PenaltyNode"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
