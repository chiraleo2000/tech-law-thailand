<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram name="อินโฟกราฟิก 9x16" id="d1">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="1920" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="TitleNode" value="📜 (ร่าง) ประกาศ กขค. กำกับโครงสร้างอัตราค่าบริการ&#10;แพลตฟอร์มเรียกรถ + จัดส่งตามอุปสงค์ (Food/Quick Commerce)&#10;รับฟังความเห็น 21 ต.ค.–19 พ.ย. 2569 · ยังไม่มีผล" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B2545;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=14;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="200" y="40" width="680" height="150" as="geometry" /></mxCell>
        <mxCell id="CoreEssence" value="ห้ามขึ้น GP / ค่าบริการแบบกะทันหัน&#10;ต้องคิดจากต้นทุนจริง แจกแจงได้ และแจ้งหรือขออนุญาตล่วงหน้า" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontSize=13;fontStyle=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="200" y="270" width="680" height="130" as="geometry" /></mxCell>
        <mxCell id="OldRule" value="🏛️ เดิม&#10;• ไม่มีเกณฑ์เฉพาะ Ride-hailing/Delivery&#10;• แพลตฟอร์มปรับ GP เองตามข้อตกลง&#10;• ใช้ ม. 50/57 กว้าง ๆ หลังเกิดปัญหา" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontColor=#4B5563;fontSize=12;fontStyle=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="460" height="220" as="geometry" /></mxCell>
        <mxCell id="NewRule" value="🚀 ใหม่ (ร่าง)&#10;• ค่าบริการอิงต้นทุนจำเป็น (use and useful)&#10;• อำนาจตลาด: แจ้งล่วงหน้า ≥ 90 วัน&#10;• อำนาจเหนือตลาด: ขออนุญาต ≥ 180 วัน&#10;• ยกเว้นส่วนแบ่งตลาด &lt; 10%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2F6;strokeColor=#0B2545;fontColor=#0B2545;fontSize=12;fontStyle=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="580" y="500" width="460" height="220" as="geometry" /></mxCell>
        <mxCell id="TechCompany" value="🏢 แพลตฟอร์มเรียกรถ / ส่งอาหาร / Quick Commerce" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B2545;strokeColor=#0B2545;fontColor=#FFFFFF;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="460" height="120" as="geometry" /></mxCell>
        <mxCell id="EndUser" value="👤 ไรเดอร์–คนขับ / ร้านอาหาร / ผู้บริโภค" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF6600;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="580" y="900" width="460" height="120" as="geometry" /></mxCell>
        <mxCell id="PenaltyNode" value="🚨 กขค. สั่งระงับ หยุด แก้ไขการขึ้นค่าบริการภายใน 120 วัน (ม. 60)&#10;+ โทษเดิมตาม พ.ร.บ.แข่งขัน 2560 (ม. 72/82)&#10;แหล่งอ้างอิง: tcct.or.th (หน้ารับฟังความคิดเห็น)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;fontColor=#991B1B;fontSize=12;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="140" y="1300" width="800" height="200" as="geometry" /></mxCell>
        <mxCell id="e0" value="สำนักงาน กขค. เปิดรับฟังร่างประกาศ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=11;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="TitleNode" target="CoreEssence"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e1" value="แทนที่การปรับ GP ตามใจแพลตฟอร์ม" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=11;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="CoreEssence" target="OldRule"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="กำกับแบบ light-handed / ex-ante (ข้อ 11–12)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=11;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="CoreEssence" target="NewRule"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="1. ทำ Fee policy + Impact assessment" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=11;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="NewRule" target="TechCompany"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="2. แจกแจงค่าบริการ ตรวจสอบ–โต้แย้งได้" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=11;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="NewRule" target="EndUser"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="3. แจ้งล่วงหน้าก่อนขึ้น GP 90/180 วัน" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=11;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="TechCompany" target="EndUser"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="4. ให้ความเห็น/ร้องเรียนการเก็บค่าบริการ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=11;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="EndUser" target="TechCompany"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="หากขึ้นค่าบริการโดยไม่มีเหตุผล" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=11;labelBackgroundColor=#F8F9FA;dashed=1;" edge="1" parent="1" source="TechCompany" target="PenaltyNode"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="ยกระดับจากการบังคับย้อนหลังสู่การกำกับล่วงหน้า" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=11;labelBackgroundColor=#F8F9FA;dashed=1;" edge="1" parent="1" source="OldRule" target="PenaltyNode"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
