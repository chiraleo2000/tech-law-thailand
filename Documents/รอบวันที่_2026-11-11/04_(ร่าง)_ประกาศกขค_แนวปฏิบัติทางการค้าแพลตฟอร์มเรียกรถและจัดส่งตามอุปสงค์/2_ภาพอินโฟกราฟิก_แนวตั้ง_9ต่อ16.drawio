<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram name="อินโฟกราฟิก 9x16" id="d1">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="1920" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="TitleNode" value="📜 (ร่าง) ประกาศ กขค. แนวปฏิบัติทางการค้า&#10;แพลตฟอร์มเรียกรถ (Ride hailing) + จัดส่งตามอุปสงค์ (On-demand)&#10;รับฟังความเห็น 4 พ.ย.–3 ธ.ค. 2569 · ยังไม่มีผล" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B2545;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=14;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="200" y="40" width="680" height="150" as="geometry" /></mxCell>
        <mxCell id="CoreEssence" value="จรรยาบรรณที่ใช้กับแอปเรียกรถ–ส่งอาหารทุกราย&#10;โปร่งใสอัลกอริทึม ห้าม Dark patterns ห้ามผูกขาดไรเดอร์–ร้านค้า" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontSize=13;fontStyle=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="200" y="270" width="680" height="130" as="geometry" /></mxCell>
        <mxCell id="OldRule" value="🏛️ เดิม&#10;• ไม่มีแนวปฏิบัติเฉพาะธุรกิจนี้&#10;• ใช้ ม. 50/57 เฉพาะรายที่มีอำนาจตลาด&#10;• ไม่มีสิทธิพกพาข้อมูลของไรเดอร์" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontColor=#4B5563;fontSize=12;fontStyle=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="460" height="220" as="geometry" /></mxCell>
        <mxCell id="NewRule" value="🚀 ใหม่ (ร่าง)&#10;• ใช้กับทุกแพลตฟอร์ม · เปิดเผยหลักอัลกอริทึม&#10;• ห้าม Dark patterns 9 แบบ · ติดป้าย Sponsored&#10;• ห้ามบังคับ Exclusive / Technical Interference&#10;• Data Portability · แจ้งเปลี่ยนแปลง ≥ 90 วัน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2F6;strokeColor=#0B2545;fontColor=#0B2545;fontSize=12;fontStyle=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="580" y="500" width="460" height="220" as="geometry" /></mxCell>
        <mxCell id="TechCompany" value="🏢 แพลตฟอร์มเรียกรถ / ส่งอาหาร / Quick Commerce" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B2545;strokeColor=#0B2545;fontColor=#FFFFFF;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="460" height="120" as="geometry" /></mxCell>
        <mxCell id="EndUser" value="👤 ไรเดอร์–คนขับ / ร้านค้า / ผู้บริโภค" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF6600;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="580" y="900" width="460" height="120" as="geometry" /></mxCell>
        <mxCell id="PenaltyNode" value="🚨 ฝ่าฝืนเสี่ยงเข้าข่ายความผิด พ.ร.บ.แข่งขัน 2560 (ข้อ 9)&#10;ม. 50 → โทษอาญา ม. 72 · ม. 57 → ปรับทางปกครอง ม. 82&#10;แหล่งอ้างอิง: tcct.or.th (หน้ารับฟังความคิดเห็น)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;fontColor=#991B1B;fontSize=12;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="140" y="1300" width="800" height="200" as="geometry" /></mxCell>
        <mxCell id="e0" value="สำนักงาน กขค. เปิดรับฟังร่างแนวปฏิบัติ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=11;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="TitleNode" target="CoreEssence"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e1" value="จากไม่มีแนวปฏิบัติเฉพาะ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=11;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="CoreEssence" target="OldRule"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="กำหนดหลักด้านราคา + ไม่ใช่ราคา 23 ข้อ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=11;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="CoreEssence" target="NewRule"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="1. เปิดเผยอัลกอริทึม ยกเลิก Dark patterns" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=11;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="NewRule" target="TechCompany"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="2. Multi-homing ได้ + ขอพกพาข้อมูล" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=11;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="NewRule" target="EndUser"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="3. แสดงรายได้สุทธิ/ปลายทาง/ค่าธรรมเนียมครบ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=11;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="TechCompany" target="EndUser"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="4. โต้แย้งการหักกลบ / ระงับข้อพิพาท" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=11;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="EndUser" target="TechCompany"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="หากบังคับ Exclusive หรือ Self-preferencing" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=11;labelBackgroundColor=#F8F9FA;dashed=1;" edge="1" parent="1" source="TechCompany" target="PenaltyNode"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="จากบทลงโทษกว้าง ๆ สู่พฤติกรรมเฉพาะเจาะจง" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=11;labelBackgroundColor=#F8F9FA;dashed=1;" edge="1" parent="1" source="OldRule" target="PenaltyNode"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
