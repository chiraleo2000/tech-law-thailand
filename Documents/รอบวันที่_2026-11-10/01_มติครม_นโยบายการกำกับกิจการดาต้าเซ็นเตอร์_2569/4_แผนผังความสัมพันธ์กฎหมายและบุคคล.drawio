        <mxCell id="CenterLaw" value="📜 นโยบายการกำกับกิจการดาต้าเซ็นเตอร์ (มติ ครม. 10 พ.ย. 2569)&#10;(ศูนย์กลางการบังคับใช้)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B2545;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=14;fontStyle=1;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="60" y="440" width="360" height="160" as="geometry" /></mxCell>
