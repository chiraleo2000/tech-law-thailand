<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net"><diagram name="อินโฟกราฟิก 9x16" id="d1"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="1920" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="TitleNode" value="📜 (ร่าง) หลักการ ก.ล.ต. Knowledge Test&#10;ก่อนจองซื้อโทเคนดิจิทัล · อนรด. 81/2569&#10;รับฟังถึง 25 พ.ย. 2569 · ยังไม่มีผล" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#0B2545;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=18;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="190" y="50" width="700" height="170" as="geometry"/></mxCell><mxCell id="CoreEssence" value="ICO portal ต้องมีแบบทดสอบตามกรอบขั้นต่ำ 6 หัวข้อ&#10;เพื่อให้ผู้ลงทุนเข้าใจสิทธิ เทคโนโลยี และความเสี่ยง" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontSize=16;fontStyle=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="190" y="300" width="700" height="120" as="geometry"/></mxCell><mxCell id="OldRule" value="🏛️ เกณฑ์ปัจจุบัน&#10;• มีหน้าที่จัดแบบทดสอบ&#10;• ยังไม่มีกรอบเนื้อหากลาง" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontColor=#4B5563;fontSize=15;fontStyle=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="520" width="430" height="230" as="geometry"/></mxCell><mxCell id="NewRule" value="🚀 หลักการใหม่&#10;• โทเคน · บล็อกเชน · Wallet&#10;• ข้อมูลโครงการ · ความเสี่ยง&#10;• ตลาดแรกและตลาดรอง" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EEF2F6;strokeColor=#0B2545;fontColor=#0B2545;fontSize=15;fontStyle=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="580" y="520" width="430" height="270" as="geometry"/></mxCell><mxCell id="TechCompany" value="🏢 ICO portal / ผู้พัฒนาระบบเสนอขายโทเคน" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#0B2545;strokeColor=#0B2545;fontColor=#FFFFFF;fontSize=15;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="950" width="430" height="150" as="geometry"/></mxCell><mxCell id="EndUser" value="👤 ผู้ลงทุนโทเคนดิจิทัล" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FF6600;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=15;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="580" y="950" width="430" height="150" as="geometry"/></mxCell><mxCell id="PenaltyNode" value="⚠️ ไม่มีโทษอาญาเพิ่มเติมในหลักการนี้&#10;มีผลภายใน 30 วันหลังลงราชกิจจานุเบกษา&#10;แหล่งอ้างอิง: sec.or.th" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FEF2F2;strokeColor=#EF4444;fontColor=#991B1B;fontSize=15;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="140" y="1280" width="800" height="190" as="geometry"/></mxCell><mxCell id="e0" value="ก.ล.ต. เปิดรับฟังหลักการ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontSize=11;" edge="1" parent="1" source="TitleNode" target="CoreEssence"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="ต่อยอดข้อ 23 ประกาศ กจ. 16/2561" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontSize=11;" edge="1" parent="1" source="CoreEssence" target="OldRule"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="กำหนดกรอบเนื้อหาขั้นต่ำ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontSize=11;" edge="1" parent="1" source="CoreEssence" target="NewRule"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="1. ปรับคลังคำถามและระบบ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontSize=11;" edge="1" parent="1" source="NewRule" target="TechCompany"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="2. ทำแบบทดสอบก่อนจองซื้อ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontSize=11;" edge="1" parent="1" source="NewRule" target="EndUser"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="3. ให้ข้อมูลความเสี่ยงชัดเจน" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontSize=11;" edge="1" parent="1" source="TechCompany" target="EndUser"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="4. ส่งความเห็นถึง 25 พ.ย." style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontSize=11;" edge="1" parent="1" source="EndUser" target="TechCompany"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="ต้องปฏิบัติตามเมื่อเกณฑ์มีผล" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontSize=11;dashed=1;" edge="1" parent="1" source="TechCompany" target="PenaltyNode"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="คงกรอบกฎหมายเดิม" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontSize=11;dashed=1;" edge="1" parent="1" source="OldRule" target="PenaltyNode"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
