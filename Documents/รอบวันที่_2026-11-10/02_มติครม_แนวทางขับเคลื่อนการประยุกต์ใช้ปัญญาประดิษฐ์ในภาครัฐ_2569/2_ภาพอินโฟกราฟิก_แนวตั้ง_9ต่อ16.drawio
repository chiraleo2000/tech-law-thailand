  <diagram name="อินโฟกราฟิก 9x16" id="d1">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="1920" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="TitleNode" value="📜 แนวทางขับเคลื่อนการใช้ AI ในภาครัฐ&#10;มติ ครม. (รับทราบ) 10 พ.ย. 2569" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B2545;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=14;fontStyle=1;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="240" y="40" width="600" height="130" as="geometry" /></mxCell>
        <mxCell id="CoreEssence" value="AI Repository → แพลตฟอร์มกลาง&#10;AI Agentic Chatbot กลาง (Shared Service)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontSize=13;" vertex="1" parent="1"><mxGeometry x="240" y="260" width="600" height="120" as="geometry" /></mxCell>
        <mxCell id="OldRule" value="🏛️ เดิม&#10;• ต่างหน่วยงานต่างพัฒนา&#10;• งบ AI 2570 ~2,583 ล้านบาท 113 โครงการ&#10;• ซ้ำซ้อน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontColor=#4B5563;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="500" width="440" height="220" as="geometry" /></mxCell>
        <mxCell id="NewRule" value="🚀 ใหม่&#10;• แพลตฟอร์มกลางแบ่งปัน Code/Prompt&#10;• Chatbot กลางผ่าน Common API&#10;• คลาวด์ GDCC + Pathumma LLM&#10;• ลดต้นทุน ~75%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2F6;strokeColor=#0B2545;fontColor=#0B2545;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="500" width="440" height="220" as="geometry" /></mxCell>
        <mxCell id="TechCompany" value="🏢 หน่วยงานรัฐ / ผู้พัฒนา AI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B2545;strokeColor=#0B2545;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="900" width="440" height="120" as="geometry" /></mxCell>
        <mxCell id="EndUser" value="👤 ประชาชนผู้ใช้บริการรัฐ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF6600;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="900" width="440" height="120" as="geometry" /></mxCell>
        <mxCell id="PenaltyNode" value="🚨 ไม่มีบทลงโทษ (แนวทางนโยบาย)&#10;แหล่งอ้างอิง: thaigov.go.th สรุปมติ ครม." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;fontColor=#991B1B;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240" y="1300" width="600" height="140" as="geometry" /></mxCell>
        <mxCell id="e0" value="ครม. รับทราบ 10 พ.ย. 2569" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=12;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="TitleNode" target="CoreEssence"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e1" value="ลดการพัฒนาแยกส่วน" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=12;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="CoreEssence" target="OldRule"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="ใช้โครงสร้างพื้นฐานร่วม" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=12;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="CoreEssence" target="NewRule"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="1. เชื่อม Common API / ใช้ Shared Service" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontSize=12;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="NewRule" target="TechCompany"><mxGeometry relative="1" as="geometry" /></mxCell>
