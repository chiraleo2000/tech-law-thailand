<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram name="อินโฟกราฟิก 9x16" id="infographic-9x16">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="1920" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n_title" value="📜 ร่าง พ.ร.บ.ว่าด้วยธุรกรรมทางอิเล็กทรอนิกส์ (ฉบับปรับปรุงใหญ่)&#10;ครม. พิจารณา 29 ก.ย. 2569" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B2545;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="20" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n_core" value="ยกเครื่อง พ.ร.บ.ธุรกรรมอิเล็กทรอนิกส์ 2544 ให้ดิจิทัลเป็นช่องทางหลัก รองรับสัญญาอัตโนมัติและตั๋วเงินอิเล็กทรอนิกส์" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="160" width="440" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n_old" value="🏛️ กฎหมายฉบับเดิม (2544 และแก้ไข)&#10;- ไม่รองรับสัญญาอัตโนมัติ/AI&#10;- ไม่ครอบคลุมตั๋วเงินอิเล็กทรอนิกส์&#10;- กำกับผู้ให้บริการวงจำกัด" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontColor=#111827;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="120" y="290" width="340" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n_new" value="🚀 ร่างกฎหมายใหม่ 2569&#10;- รับรองสัญญาอัตโนมัติ/Smart Contract&#10;- รองรับเช็ค/ตั๋วแลกเงินอิเล็กทรอนิกส์&#10;- กำกับผู้ให้บริการ 7 ประเภทตามความเสี่ยง" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2F6;strokeColor=#0B2545;fontColor=#111827;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="290" width="340" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n_tech" value="🏢 ผู้ให้บริการ 7 ประเภท&#10;(ยืนยันตัวตน/ลายมือชื่อ/ประทับเวลา/เก็บข้อมูล/โดเมน/ตั๋วเงิน)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B2545;strokeColor=#0B2545;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="450" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n_user" value="👤 ประชาชน / ผู้ทำธุรกรรมออนไลน์" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF6600;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="580" width="400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n_step1" value="1️⃣ ตรวจพิจารณาโดยสำนักงานคณะกรรมการกฤษฎีกาอย่างเป็นทางการ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontColor=#111827;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="690" width="440" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n_step2" value="2️⃣ เสนอเข้าสู่กระบวนการพิจารณาของรัฐสภา" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2F6;strokeColor=#0B2545;fontColor=#111827;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="780" width="440" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n_step3" value="3️⃣ ประกาศในราชกิจจานุเบกษา แล้วมีผล 180 วันถัดไป" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B2545;strokeColor=#0B2545;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="870" width="440" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n_penalty" value="🚨 รายละเอียดบทลงโทษรอกฎหมายลูก 26 ฉบับ (พ.ร.ฎ. 2, กฎกระทรวง 3, ประกาศ 21)&#10;แหล่งอ้างอิง: prd.go.th (แถลงข่าว ครม. 29 ก.ย. 2569)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;fontColor=#991B1B;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="970" width="440" height="100" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="คณะรัฐมนตรีพิจารณาเห็นชอบในหลักการ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#4B5563;" edge="1" parent="1" source="n_title" target="n_core">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="ยกเลิกและรวบรวมข้อกำหนดเดิมที่กระจัดกระจาย" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#4B5563;" edge="1" parent="1" source="n_core" target="n_old">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="บังคับใช้กรอบกำกับดูแลใหม่ตามความเสี่ยง" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#4B5563;" edge="1" parent="1" source="n_core" target="n_new">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="1. กำหนดให้ขึ้นทะเบียน/ขอใบอนุญาตตาม 7 ประเภทบริการ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#4B5563;" edge="1" parent="1" source="n_new" target="n_tech">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="2. มอบสิทธิใช้ธุรกรรมดิจิทัลเป็นช่องทางหลักโดยไม่ตัดสิทธิใช้กระดาษ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#4B5563;" edge="1" parent="1" source="n_new" target="n_user">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="3. ให้บริการที่น่าเชื่อถือและเก็บรักษาข้อมูลตามเกณฑ์" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#4B5563;" edge="1" parent="1" source="n_tech" target="n_user">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="4. ใช้สิทธิโต้แย้ง/ฟ้องร้องโดยอาศัยหลักฐานอิเล็กทรอนิกส์" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#4B5563;" edge="1" parent="1" source="n_user" target="n_tech">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="5. รอความคืบหน้าเข้าสู่กระบวนการนิติบัญญัติ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#4B5563;" edge="1" parent="1" source="n_user" target="n_step1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="6. ผ่านการตรวจร่างแล้วส่งต่อ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#4B5563;" edge="1" parent="1" source="n_step1" target="n_step2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="7. รัฐสภาให้ความเห็นชอบแล้วนำขึ้นทูลเกล้าฯ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#4B5563;" edge="1" parent="1" source="n_step2" target="n_step3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="หากผู้ให้บริการไม่ปฏิบัติตามเกณฑ์กำกับความเสี่ยงที่จะกำหนดในกฎหมายลูก" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#EF4444;dashed=1;" edge="1" parent="1" source="n_step3" target="n_penalty">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" value="ถูกยกเลิก/รวบรวมเข้ากรอบใหม่เมื่อกฎหมายมีผลบังคับใช้" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#9CA3AF;dashed=1;" edge="1" parent="1" source="n_old" target="n_penalty">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
