<mxfile host="thai-tech-law-pipeline"><diagram name="หน้า-1"><mxGraphModel dx="1080" dy="1920" grid="1" gridSize="10" pageWidth="1080" pageHeight="1920" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="TitleNode" value="📜 (ร่าง) แนวปฏิบัติประเมิน Cloud Security Posture Assessment&lt;br/&gt;NCSA SP 500-2 v1.0 · รับฟัง 23 พ.ย.–23 ธ.ค. 2569" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B2545;strokeColor=#FF6600;fontColor=#FFFFFF;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="480" height="150" as="geometry"/></mxCell><mxCell id="CoreEssence" value="Checklist 45 ข้อ 5 หมวด ระดับการดำเนินงาน 3 ระดับ&lt;br/&gt;ให้ผู้ใช้บริการคลาวด์ประเมินตนเอง (ไม่ใช่การรับรอง)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="560" y="40" width="480" height="150" as="geometry"/></mxCell><mxCell id="OldRule" value="🏛️ ชุดมาตรฐานคลาวด์เดิม&lt;br/&gt;• ประกาศ กมช. มาตรฐานคลาวด์ 2567&lt;br/&gt;• Self-Assessment CSC v1.0&lt;br/&gt;• ยังไม่มีแบบวัดระดับ Posture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontColor=#4B5563;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="480" height="150" as="geometry"/></mxCell><mxCell id="NewRule" value="🚀 ร่าง CSPA ใหม่&lt;br/&gt;• DevSecOps: IaC / CI/CD / SCA&lt;br/&gt;• SOC + Log กันแก้ไข + ซิงก์เวลา&lt;br/&gt;• Secrets / CSPM / แบ่งส่วนเครือข่าย&lt;br/&gt;• AI: Poisoning / Model Theft / DoS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2F6;strokeColor=#0B2545;fontColor=#0B2545;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="560" y="280" width="480" height="150" as="geometry"/></mxCell><mxCell id="TechCompany" value="🏢 หน่วยงานผู้ใช้คลาวด์ / CSP / ทีม DevSecOps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B2545;strokeColor=#0B2545;fontColor=#FFFFFF;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="480" height="150" as="geometry"/></mxCell><mxCell id="EndUser" value="👤 ประชาชนเจ้าของข้อมูลในระบบคลาวด์" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF6600;strokeColor=#FF6600;fontColor=#FFFFFF;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="560" y="520" width="480" height="150" as="geometry"/></mxCell><mxCell id="PenaltyNode" value="⚠️ ไม่มีโทษใหม่: แนวปฏิบัติสมัครใจ&lt;br/&gt;แต่ CII/หน่วยงานรัฐยังต้องทำตามมาตรฐานคลาวด์ 2567 ภายใต้ พ.ร.บ.ไซเบอร์ 2562&lt;br/&gt;แหล่งอ้างอิง: law.go.th / ncsa.or.th" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;fontColor=#991B1B;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="480" height="150" as="geometry"/></mxCell><mxCell id="e0" value="สกมช. + NOCSET TF501 เปิดรับฟัง" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontFamily=Tahoma;" edge="1" parent="1" source="TitleNode" target="CoreEssence"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="เสริม ไม่ยกเลิกมาตรฐานเดิม" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontFamily=Tahoma;" edge="1" parent="1" source="CoreEssence" target="OldRule"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="เพิ่มมิติ Maturity และ AI Security" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontFamily=Tahoma;" edge="1" parent="1" source="CoreEssence" target="NewRule"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="1. ประเมินตนเอง 45 ข้อ หาช่องว่าง" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontFamily=Tahoma;" edge="1" parent="1" source="NewRule" target="TechCompany"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="2. ข้อมูลบนคลาวด์ได้รับการปกป้องดีขึ้น" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontFamily=Tahoma;" edge="1" parent="1" source="NewRule" target="EndUser"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="3. แก้ Misconfiguration และป้องกัน Log" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontFamily=Tahoma;" edge="1" parent="1" source="TechCompany" target="EndUser"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="4. ส่งความเห็น/แจ้งเหตุผิดปกติ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontFamily=Tahoma;" edge="1" parent="1" source="EndUser" target="TechCompany"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="หากไม่ถึงมาตรฐานคลาวด์ 2567 (CII/รัฐ)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontFamily=Tahoma;dashed=1;" edge="1" parent="1" source="TechCompany" target="PenaltyNode"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="กลไกบังคับยังอยู่ที่ พ.ร.บ.ไซเบอร์" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontFamily=Tahoma;dashed=1;" edge="1" parent="1" source="OldRule" target="PenaltyNode"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
