<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net"><diagram name="อินโฟกราฟิก 9x16" id="d1"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="1920" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="TitleNode" value="📜 (ร่าง) แก้ไขประมวลกฎหมายอาญา&#10;คุ้มครองเด็กจากความผิดทางออนไลน์&#10;ครม. เห็นชอบ 17 พ.ย. 2569 · ยังไม่มีผล" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#0B2545;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=18;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="190" y="50" width="700" height="170" as="geometry"/></mxCell><mxCell id="CoreEssence" value="เพิ่มฐานความผิด 5 รูปแบบ&#10;ปิดช่องว่างการแสวงหาประโยชน์และคุกคามเด็กผ่านดิจิทัล" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontSize=16;fontStyle=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="190" y="300" width="700" height="120" as="geometry"/></mxCell><mxCell id="OldRule" value="🏛️ กฎหมายปัจจุบัน&#10;• ใช้ฐานความผิดทั่วไปบางส่วน&#10;• ไม่ครอบคลุมบางพฤติกรรมออนไลน์" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontColor=#4B5563;fontSize=15;fontStyle=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="520" width="430" height="230" as="geometry"/></mxCell><mxCell id="NewRule" value="🚀 ร่างใหม่&#10;• Grooming · Sextortion · Sexting&#10;• Stalking · Bullying&#10;• เพิ่มโทษบางกรณีเมื่อทำผ่านออนไลน์" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EEF2F6;strokeColor=#0B2545;fontColor=#0B2545;fontSize=15;fontStyle=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="580" y="520" width="430" height="270" as="geometry"/></mxCell><mxCell id="TechCompany" value="🏢 แพลตฟอร์มออนไลน์ / ผู้ให้บริการแชตและโซเชียล" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#0B2545;strokeColor=#0B2545;fontColor=#FFFFFF;fontSize=15;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="950" width="430" height="150" as="geometry"/></mxCell><mxCell id="EndUser" value="👤 เด็ก เยาวชน ผู้ปกครอง และผู้ใช้ออนไลน์" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FF6600;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=15;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="580" y="950" width="430" height="150" as="geometry"/></mxCell><mxCell id="PenaltyNode" value="⚠️ โทษจำคุกและปรับตามฐานความผิด&#10;ตัวเลขจากร่างปี 2568 อาจเปลี่ยนในร่างล่าสุด&#10;แหล่งอ้างอิง: แถลงมติ ครม. 17 พ.ย. 2569" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FEF2F2;strokeColor=#EF4444;fontColor=#991B1B;fontSize=15;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="140" y="1280" width="800" height="190" as="geometry"/></mxCell><mxCell id="e0" value="ครม. เห็นชอบร่างที่กฤษฎีกาตรวจแล้ว" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontSize=11;" edge="1" parent="1" source="TitleNode" target="CoreEssence"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="เติมช่องว่างของกฎหมายเดิม" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontSize=11;" edge="1" parent="1" source="CoreEssence" target="OldRule"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="กำหนดความผิดและโทษเพิ่ม" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontSize=11;" edge="1" parent="1" source="CoreEssence" target="NewRule"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="1. ทบทวนระบบแจ้งเหตุและหลักฐาน" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontSize=11;" edge="1" parent="1" source="NewRule" target="TechCompany"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="2. ได้รับความคุ้มครองชัดเจนขึ้น" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontSize=11;" edge="1" parent="1" source="NewRule" target="EndUser"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="3. จัดช่องทางช่วยเหลือผู้ใช้" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontSize=11;" edge="1" parent="1" source="TechCompany" target="EndUser"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="4. แจ้งเหตุและเก็บหลักฐาน" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontSize=11;" edge="1" parent="1" source="EndUser" target="TechCompany"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="เสี่ยงรับผิดหากมีส่วนสนับสนุน" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontSize=11;dashed=1;" edge="1" parent="1" source="TechCompany" target="PenaltyNode"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="คงความผิดเดิมและเพิ่มฐานใหม่" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#0B2545;fontColor=#111827;labelBackgroundColor=#F8F9FA;fontSize=11;dashed=1;" edge="1" parent="1" source="OldRule" target="PenaltyNode"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
