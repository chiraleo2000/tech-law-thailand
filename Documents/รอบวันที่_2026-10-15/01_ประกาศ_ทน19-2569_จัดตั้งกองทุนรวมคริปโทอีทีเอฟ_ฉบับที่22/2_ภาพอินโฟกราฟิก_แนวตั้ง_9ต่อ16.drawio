<mxfile host="app.diagrams.net"><diagram name="อินโฟกราฟิก 9x16" id="d1"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="1920" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="ทน.19/2569 จัดตั้งกองทุนคริปโทอีทีเอฟ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B2545;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=14;" vertex="1" parent="1"><mxGeometry x="240" y="30" width="600" height="100" as="geometry" /></mxCell><mxCell id="c" value="เพิ่มกองทุนรวมคริปโทอีทีเอฟเป็นประเภทกองทุนที่จัดตั้งได้ บลจ.ต้องแสดงความพร้อมบุคลากร ระบบงาน ผู้ให้บริการ ชื่อกองทุนต้องสะท้อนคริปโทที่ลงทุน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontSize=14;" vertex="1" parent="1"><mxGeometry x="190" y="200" width="700" height="130" as="geometry" /></mxCell><mxCell id="o" value="เดิม: ไม่มีประเภทกองทุนคริปโทอีทีเอฟ • ไม่มีเกณฑ์ชื่อกองทุนเฉพาะ • ไม่มีเกณฑ์ความพร้อม บลจ. สำหรับคริปโท" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontColor=#4B5563;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="410" width="440" height="150" as="geometry" /></mxCell><mxCell id="n" value="ใหม่: เพิ่มรายการ (10) กองทุนคริปโทอีทีเอฟ • ชื่อกองทุนสะท้อนคริปโท • บลจ.ต้องพร้อมทั้งคน ระบบ ผู้ให้บริการ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2F6;strokeColor=#0B2545;fontColor=#0B2545;fontSize=14;" vertex="1" parent="1"><mxGeometry x="580" y="410" width="440" height="150" as="geometry" /></mxCell><mxCell id="tc" value="🏢 บริษัทจัดการกองทุน (บลจ.)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B2545;strokeColor=#0B2545;fontColor=#FFFFFF;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="660" width="440" height="90" as="geometry" /></mxCell><mxCell id="pv" value="👤 ผู้ลงทุนทั่วไป" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF6600;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=14;" vertex="1" parent="1"><mxGeometry x="580" y="660" width="440" height="90" as="geometry" /></mxCell><mxCell id="rd" value="🏛️ ก.ล.ต. / ก.ต.ท." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontColor=#4B5563;fontSize=14;" vertex="1" parent="1"><mxGeometry x="320" y="840" width="440" height="90" as="geometry" /></mxCell><mxCell id="pn" value="⚠️ ไม่มีโทษในตัวประกาศ ใช้กลไกกำกับตาม พ.ร.บ.หลักทรัพย์ฯ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;fontColor=#991B1B;fontSize=14;" vertex="1" parent="1"><mxGeometry x="240" y="1020" width="600" height="110" as="geometry" /></mxCell><mxCell id="e0" value="ประกาศใช้" style="endArrow=classic;html=1;fontSize=12;" edge="1" parent="1" source="t" target="c"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="เดิม" style="endArrow=classic;html=1;fontSize=12;" edge="1" parent="1" source="c" target="o"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="ใหม่" style="endArrow=classic;html=1;fontSize=12;" edge="1" parent="1" source="c" target="n"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="1. ยื่นขอจัดตั้งกองทุนพร้อมหลักฐานความพร้อม" style="endArrow=classic;html=1;fontSize=12;" edge="1" parent="1" source="n" target="tc"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="2. เสนอขายหน่วยลงทุนที่ชื่อสื่อถึงคริปโท" style="endArrow=classic;html=1;fontSize=12;" edge="1" parent="1" source="tc" target="pv"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="3. ตรวจสอบความพร้อมก่อนอนุมัติจัดตั้ง" style="endArrow=classic;html=1;fontSize=12;" edge="1" parent="1" source="pv" target="rd"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="4. กำกับดูแล" style="endArrow=classic;html=1;fontSize=12;" edge="1" parent="1" source="rd" target="tc"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="หากฝ่าฝืน" style="endArrow=classic;html=1;fontSize=12;" edge="1" parent="1" source="tc" target="pn"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>