        <mxCell id="1" parent="0" />
        <mxCell id="CenterLaw" value="📜 (ร่าง) ประกาศ ก.ล.ต. 3 ฉบับ (อนจ. 85/2569)&#10;คุณสมบัติผู้รับฝากสินทรัพย์ดิจิทัลต่างประเทศของกองทุน&#10;(ศูนย์กลางการบังคับใช้)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B2545;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=14;fontStyle=1;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="700" y="420" width="420" height="140" as="geometry" /></mxCell>
        <mxCell id="L1" value="พ.ร.บ.หลักทรัพย์และตลาดหลักทรัพย์ 2535&#10;(ม.16/6 · 117 · 133 · 137)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#0B2545;fontColor=#0B2545;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="380" height="90" as="geometry" /></mxCell>
        <mxCell id="L2" value="พ.ร.ก.ธุรกิจสินทรัพย์ดิจิทัล 2561&#10;+ กธ. 19/2561 ภาคผนวก 6 / เกณฑ์ crypto ETF 2569" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#0B2545;fontColor=#0B2545;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="380" height="90" as="geometry" /></mxCell>
        <mxCell id="L3" value="พ.ร.บ.ไซเบอร์ 2562&#10;(ตลาดทุน = CII · third-party risk)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#0B2545;fontColor=#0B2545;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="340" width="380" height="90" as="geometry" /></mxCell>
        <mxCell id="L4" value="PDPA 2562 ม.28–29 (โอนข้อมูลข้ามพรมแดน)&#10;+ พ.ร.บ.ฟอกเงิน 2542 / Travel Rule" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#0B2545;fontColor=#0B2545;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="480" width="380" height="90" as="geometry" /></mxCell>
        <mxCell id="TechDev" value="บลจ. / ผู้จัดการกองทุนส่วนบุคคล" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1300" y="120" width="380" height="90" as="geometry" /></mxCell>
        <mxCell id="TechInfra" value="ผู้ดูแลผลประโยชน์ MF · ผู้รับฝากทรัพย์สิน PF&#10;· DA custodian ต่างประเทศ (wallet/MPC/multisig)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1300" y="280" width="380" height="110" as="geometry" /></mxCell>
        <mxCell id="User" value="ผู้ลงทุนกองทุนรวม / กองทุนส่วนบุคคลที่ลงทุนคริปโท" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;fontColor=#166534;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1300" y="640" width="380" height="80" as="geometry" /></mxCell>
        <mxCell id="Victim" value="ผู้ลงทุนที่เสี่ยงเสียหายจาก custodian ล้มละลาย/ถูกเจาะระบบ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;fontColor=#166534;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1300" y="780" width="380" height="90" as="geometry" /></mxCell>
        <mxCell id="Regulator" value="ก.ล.ต. / คณะกรรมการกำกับตลาดทุน · หน่วยงานกำกับต่างประเทศ (IOSCO MMoU Signatory A)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;fontColor=#991B1B;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="700" y="760" width="420" height="110" as="geometry" /></mxCell>
        <mxCell id="e1" value="1. ออกตามมาตรา 16/6, 117, 133, 137" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#0B2545;fontColor=#111827;fontSize=11;labelBackgroundColor=#F8F9FA;strokeWidth=2;" edge="1" parent="1" source="CenterLaw" target="L1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="2. คงคุณสมบัติ 12 ข้อ + ยกระดับเท่า crypto ETF" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#0B2545;fontColor=#111827;fontSize=11;labelBackgroundColor=#F8F9FA;strokeWidth=2;" edge="1" parent="1" source="CenterLaw" target="L2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="3. ผูกมาตรการ cybersecurity ของ custodian" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#0B2545;fontColor=#111827;fontSize=11;labelBackgroundColor=#F8F9FA;strokeWidth=2;" edge="1" parent="1" source="CenterLaw" target="L3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="4. โอนข้อมูล/สินทรัพย์ไปต่างประเทศต้องมีมาตรฐาน" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#0B2545;fontColor=#111827;fontSize=11;labelBackgroundColor=#F8F9FA;strokeWidth=2;" edge="1" parent="1" source="CenterLaw" target="L4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="5. คัดเลือก custodian ตามเงื่อนไข 2 ชั้น (ทน.)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#0B2545;fontColor=#111827;fontSize=11;labelBackgroundColor=#F8F9FA;strokeWidth=3;" edge="1" parent="1" source="CenterLaw" target="TechDev"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="6. ระบบงานคัดเลือก/ติดตามตัวแทนเก็บรักษา (สธ./สน.)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#0B2545;fontColor=#111827;fontSize=11;labelBackgroundColor=#F8F9FA;strokeWidth=3;" edge="1" parent="1" source="CenterLaw" target="TechInfra"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="7. บริหารกองทุนด้วย custodian ที่กำกับเข้มงวด" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#0B2545;fontColor=#111827;fontSize=11;labelBackgroundColor=#F8F9FA;strokeWidth=2;" edge="1" parent="1" source="TechDev" target="User"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="8. แยกกระเป๋า + ยืนยันการโอน ≥ 2 คน" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#0B2545;fontColor=#111827;fontSize=11;labelBackgroundColor=#F8F9FA;strokeWidth=2;" edge="1" parent="1" source="TechInfra" target="Victim"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="9. ส่งความเห็นต่อร่างถึง 27 ธ.ค. 2569" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#0B2545;fontColor=#111827;fontSize=11;labelBackgroundColor=#F8F9FA;strokeWidth=2;" edge="1" parent="1" source="User" target="TechDev"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" value="10. เรียกร้องให้ย้ายทรัพย์สินออกจาก custodian ไม่ผ่านเกณฑ์" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#0B2545;fontColor=#111827;fontSize=11;labelBackgroundColor=#F8F9FA;strokeWidth=2;" edge="1" parent="1" source="Victim" target="TechDev"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" value="11. ขออนุมัติจัดตั้ง/รายงานการลงทุนต่อ ก.ล.ต." style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#0B2545;fontColor=#111827;fontSize=11;labelBackgroundColor=#F8F9FA;dashed=1;strokeWidth=2;" edge="1" parent="1" source="TechDev" target="Regulator"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" value="12. ประกาศรายชื่อประเทศ + สภาวการณ์ crypto ETF" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#0B2545;fontColor=#111827;fontSize=11;labelBackgroundColor=#F8F9FA;dashed=1;strokeWidth=2;" edge="1" parent="1" source="Regulator" target="TechInfra"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e13" value="13. ร้องเรียนต่อ ก.ล.ต. (SEC Complaint Center 1207)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#0B2545;fontColor=#111827;fontSize=11;labelBackgroundColor=#F8F9FA;dashed=1;strokeWidth=2;" edge="1" parent="1" source="Victim" target="Regulator"><mxGeometry relative="1" as="geometry" /></mxCell>
