<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram name="อินโฟกราฟิก 9x16" id="d1">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="1920" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="TitleNode" value="📜 (ร่าง) ประกาศ ก.ล.ต. 3 ฉบับ ปรับคุณสมบัติ&#10;ผู้รับฝากสินทรัพย์ดิจิทัลต่างประเทศของกองทุน (อนจ. 85/2569)&#10;รับฟังความเห็น 26 พ.ย.–27 ธ.ค. 2569 · ยังไม่มีผล" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B2545;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=14;fontStyle=1;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="200" y="40" width="680" height="150" as="geometry" /></mxCell>
        <mxCell id="CoreEssence" value="กองทุนรวม/กองทุนส่วนบุคคลที่ลงทุนคริปโท ต้องฝาก DA กับ custodian ต่างประเทศ&#10;ที่กำกับโดย IOSCO MMoU Signatory A หรือประเทศในรายชื่อ ก.ล.ต. · เท่ากับเกณฑ์ crypto ETF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="160" y="270" width="760" height="150" as="geometry" /></mxCell>
        <mxCell id="OldRule" value="🏛️ เดิม (ทน. 87/2558 · สธ. 60/2558 · สน. 27/2543)&#10;• custodian ต่างประเทศผ่านคุณสมบัติ 12 ข้อ (ภาคผนวก 6 กธ. 19/2561)&#10;• หน่วยงานกำกับไม่ระบุมาตรฐาน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontColor=#4B5563;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="470" height="240" as="geometry" /></mxCell>
        <mxCell id="NewRule" value="🚀 ใหม่ (ร่าง)&#10;• คุณสมบัติ 12 ข้อเดิม + อยู่ใต้ IOSCO MMoU Signatory A&#10;  หรือประเทศในรายชื่อ ก.ล.ต. (ระยะแรก 11 ประเทศ)&#10;• crypto ETF ตั้ง custodian นอกได้ตามสภาวการณ์ที่สำนักงานกำหนด&#10;• กองทุนเดิมปรับภายใน 120 วัน · คาดมีผลไตรมาส 1/2570" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2F6;strokeColor=#0B2545;fontColor=#0B2545;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="570" y="520" width="470" height="300" as="geometry" /></mxCell>
        <mxCell id="TechCompany" value="🏢 บลจ. / ผู้ดูแลผลประโยชน์ / ผู้รับฝากทรัพย์สิน&#10;+ DA custodian ต่างประเทศ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B2545;strokeColor=#0B2545;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="980" width="420" height="130" as="geometry" /></mxCell>
        <mxCell id="EndUser" value="👤 ผู้ลงทุนกองทุนรวม/กองทุนส่วนบุคคลที่ลงทุนคริปโท" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF6600;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="980" width="420" height="130" as="geometry" /></mxCell>
        <mxCell id="PenaltyNode" value="🚨 ไม่มีโทษใหม่: ใช้บทบัญญัติเดิมตาม พ.ร.บ.หลักทรัพย์ฯ 2535&#10;ก.ล.ต. ไม่อนุมัติกองทุนที่ไม่เป็นไปตามเกณฑ์&#10;แหล่งอ้างอิง: sec.or.th (อนจ. 85/2569) / law.go.th" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;fontColor=#991B1B;fontSize=12;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="160" y="1300" width="760" height="170" as="geometry" /></mxCell>
        <mxCell id="e1" value="ก.ล.ต. เปิดรับฟังร่างประกาศ 3 ฉบับ (ทน./สธ./สน.)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#0B2545;fontColor=#111827;fontSize=11;labelBackgroundColor=#F8F9FA;strokeWidth=2;" edge="1" parent="1" source="TitleNode" target="CoreEssence"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="แก้ไขข้อ 9/2 (2) ทน. 87/2558 และเกณฑ์คู่ขนาน" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#0B2545;fontColor=#111827;fontSize=11;labelBackgroundColor=#F8F9FA;strokeWidth=2;" edge="1" parent="1" source="CoreEssence" target="OldRule"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="เพิ่มเงื่อนไขหน่วยงานกำกับ + ข้อ 9/3 ใหม่" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#0B2545;fontColor=#111827;fontSize=11;labelBackgroundColor=#F8F9FA;strokeWidth=2;" edge="1" parent="1" source="CoreEssence" target="NewRule"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="1. คัดเลือก/ติดตาม custodian แบบ 2 ชั้น" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#0B2545;fontColor=#111827;fontSize=11;labelBackgroundColor=#F8F9FA;strokeWidth=2;" edge="1" parent="1" source="NewRule" target="TechCompany"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="2. ทรัพย์สินกองทุนได้รับคุ้มครองเท่า crypto ETF" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#0B2545;fontColor=#111827;fontSize=11;labelBackgroundColor=#F8F9FA;strokeWidth=2;" edge="1" parent="1" source="NewRule" target="EndUser"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="3. เปิดเผยข้อมูลและเก็บ DA อย่างปลอดภัย" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#0B2545;fontColor=#111827;fontSize=11;labelBackgroundColor=#F8F9FA;strokeWidth=2;" edge="1" parent="1" source="TechCompany" target="EndUser"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="4. แสดงความเห็นถึง 27 ธ.ค. 2569 / ติดตามกองทุน" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#0B2545;fontColor=#111827;fontSize=11;labelBackgroundColor=#F8F9FA;strokeWidth=2;" edge="1" parent="1" source="EndUser" target="TechCompany"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="หากใช้ custodian ไม่ผ่านเกณฑ์เกิน 120 วัน" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#0B2545;fontColor=#111827;fontSize=11;labelBackgroundColor=#F8F9FA;dashed=1;strokeWidth=2;" edge="1" parent="1" source="TechCompany" target="PenaltyNode"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="คงบทลงโทษเดิมตาม พ.ร.บ.หลักทรัพย์ฯ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#0B2545;fontColor=#111827;fontSize=11;labelBackgroundColor=#F8F9FA;dashed=1;strokeWidth=2;" edge="1" parent="1" source="OldRule" target="PenaltyNode"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
