er"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="9. ให้บริการเก็บ โอน และรับชำระ 1:1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeWidth=2;strokeColor=#0B2545;fontSize=12;fontColor=#111827;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="Wallet" target="User"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="10. ร้องเรียนและขอกู้คืนการเข้าถึง" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeWidth=2;strokeColor=#0B2545;fontSize=12;fontColor=#111827;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="Victim" target="Wallet"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="11. เปิดเผยยอดสินทรัพย์หนุนหลังรายวัน" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;dashed=1;strokeWidth=2;strokeColor=#0B2545;fontSize=12;fontColor=#111827;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="Issuer" target="Regulator"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="12. คัดเลือก issuer ตรวจสอบ และสั่งยุติได้" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;dashed=1;strokeWidth=2;strokeColor=#0B2545;fontSize=12;fontColor=#111827;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="Regulator" target="Issuer"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
