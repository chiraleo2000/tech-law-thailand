<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net"><diagram name="อินโฟกราฟิก 9x16" id="d1"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="1920" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="TitleNode" value="📜 (ร่าง) หลักการ ธปท. กำกับ THB Stablecoin&#10;ผู้ออกเหรียญและผู้ให้บริการกระเป๋าเงิน&#10;รับฟัง 19 ต.ค. – 17 พ.ย. 2569 · ยังไม่มีผล" style="rounded=1;whiteSpace=wrap;html=0;strokeWidth=2;fillColor=#0B2545;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1000" height="298" as="geometry"/></mxCell><mxCell id="CoreEssence" value="เหรียญอิงบาท 1:1 หนุนด้วยเงินฝาก 100%&#10;ใช้ได้เฉพาะ wallet ที่ผ่าน KYC · ห้ามจ่ายดอกเบี้ย" style="rounded=1;whiteSpace=wrap;html=0;strokeWidth=2;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="408" width="1000" height="298" as="geometry"/></mxCell><mxCell id="OldRule" value="🏛️ สภาพเดิม&#10;• ไม่มีกรอบ stablecoin บาท&#10;• e-money ระบบปิด&#10;• ไม่สนับสนุนคริปโตชำระเงิน" style="rounded=1;whiteSpace=wrap;html=0;strokeWidth=2;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontColor=#4B5563;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="776" width="480" height="298" as="geometry"/></mxCell><mxCell id="NewRule" value="🚀 ร่างหลักการ&#10;• ใบอนุญาตตาม พ.ร.บ.ระบบการชำระเงิน&#10;• issuer น้อยราย · wallet ไม่จำกัด&#10;• freeze / seize / burn ได้" style="rounded=1;whiteSpace=wrap;html=0;strokeWidth=2;fillColor=#EEF2F6;strokeColor=#0B2545;fontColor=#0B2545;fontSize=14;" vertex="1" parent="1"><mxGeometry x="560" y="776" width="480" height="298" as="geometry"/></mxCell><mxCell id="TechCompany" value="🏢 issuer / wallet provider&#10;/ ผู้พัฒนา DLT-smart contract" style="rounded=1;whiteSpace=wrap;html=0;strokeWidth=2;fillColor=#0B2545;strokeColor=#0B2545;fontColor=#FFFFFF;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="1144" width="480" height="298" as="geometry"/></mxCell><mxCell id="EndUser" value="👤 ผู้ถือเหรียญ / ร้านค้า" style="rounded=1;whiteSpace=wrap;html=0;strokeWidth=2;fillColor=#FF6600;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=14;" vertex="1" parent="1"><mxGeometry x="560" y="1144" width="480" height="298" as="geometry"/></mxCell><mxCell id="PenaltyNode" value="🚨 ยังไม่มีโทษ · รอประกาศกระทรวงการคลัง&#10;และหลักเกณฑ์ ธปท. ตาม พ.ร.บ.ระบบการชำระเงิน&#10;แหล่งอ้างอิง: bot.or.th" style="rounded=1;whiteSpace=wrap;html=0;strokeWidth=2;fillColor=#FEF2F2;strokeColor=#EF4444;fontColor=#991B1B;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1512" width="1000" height="298" as="geometry"/></mxCell><mxCell id="e0" value="เปิดรับฟังความคิดเห็นก่อนเสนอกระทรวงการคลัง" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeWidth=2;strokeColor=#0B2545;fontSize=12;fontColor=#111827;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="TitleNode" target="CoreEssence"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="เติมช่องว่างที่ไม่มีกรอบกำกับเดิม" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeWidth=2;strokeColor=#0B2545;fontSize=12;fontColor=#111827;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="CoreEssence" target="OldRule"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="ตั้งระบบใบอนุญาตและมาตรฐานขั้นต่ำ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeWidth=2;strokeColor=#0B2545;fontSize=12;fontColor=#111827;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="CoreEssence" target="NewRule"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="1. ต้องมีระบบ DLT ปลอดภัยและ on-chain analytics" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeWidth=2;strokeColor=#0B2545;fontSize=12;fontColor=#111827;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="NewRule" target="TechCompany"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="2. ได้สิทธิไถ่ถอน 1:1 ภายใน 1 วันทำการ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeWidth=2;strokeColor=#0B2545;fontSize=12;fontColor=#111827;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="NewRule" target="EndUser"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="3. ให้บริการเก็บรักษา โอน และรับชำระ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeWidth=2;strokeColor=#0B2545;fontSize=12;fontColor=#111827;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="TechCompany" target="EndUser"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="4. ร้องเรียนผ่าน wallet provider" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeWidth=2;strokeColor=#0B2545;fontSize=12;fontColor=#111827;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="EndUser" target="TechCompany"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="เมื่อมีประกาศแล้วต้องได้รับอนุญาตก่อนให้บริการ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;dashed=1;strokeWidth=2;strokeColor=#0B2545;fontSize=12;fontColor=#111827;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="TechCompany" target="PenaltyNode"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="เปลี่ยนจากไม่มีกรอบเป็นธุรกิจที่ต้องขออนุญาต" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;dashed=1;strokeWidth=2;strokeColor=#0B2545;fontSize=12;fontColor=#111827;labelBackgroundColor=#F8F9FA;" edge="1" parent="1" source="OldRule" target="PenaltyNode"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
