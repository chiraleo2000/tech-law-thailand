<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net"><diagram name="อินโฟกราฟิก 9x16" id="d1"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="1920" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="TitleNode" value="📜 ประกาศ คธอ. ฉบับที่ 2 มาตรการป้องกันอาชญากรรมทางเทคโนโลยี&lt;br/&gt;ราชกิจจาฯ 5 พ.ค. 2569 · มีผลบังคับใช้ 1 พ.ย. 2569" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B2545;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1000" height="120" as="geometry"/></mxCell><mxCell id="CoreEssence" value="💡 แพลตฟอร์มโซเชียลที่รับค่าโฆษณา ต้องพิสูจน์ตัวตนผู้ลงโฆษณา&lt;br/&gt;ทุกครั้งก่อนโฆษณา และเก็บข้อมูลอย่างน้อย 90 วัน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="1000" height="120" as="geometry"/></mxCell><mxCell id="OldRule" value="🏛️ ประกาศฉบับแรก (ราชกิจจาฯ 4 ก.ค. 2568)&lt;br/&gt;• ระงับข้อมูลปลอมภายใน 24 ชม. หลังถูกแจ้ง&lt;br/&gt;• ยังไม่บังคับยืนยันตัวตนผู้ลงโฆษณา" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontColor=#4B5563;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="470" height="170" as="geometry"/></mxCell><mxCell id="NewRule" value="🚀 ประกาศฉบับที่ 2&lt;br/&gt;• ยืนยันตัวตนผู้ลงโฆษณาทุกครั้ง&lt;br/&gt;• ตรวจบัตรรัฐ/เทียบใบหน้า หรือ Digital ID&lt;br/&gt;• ไม่ต้องทำซ้ำถ้ายืนยันไว้ภายใน 1 ปี" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2F6;strokeColor=#0B2545;fontColor=#0B2545;fontSize=14;" vertex="1" parent="1"><mxGeometry x="570" y="400" width="470" height="170" as="geometry"/></mxCell><mxCell id="TechCompany" value="🏢 ผู้ให้บริการสื่อสังคมออนไลน์&lt;br/&gt;ที่ได้รับค่าบริการโฆษณา" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B2545;strokeColor=#0B2545;fontColor=#FFFFFF;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="470" height="120" as="geometry"/></mxCell><mxCell id="EndUser" value="👤 ผู้ลงโฆษณา / ผู้ชำระค่าโฆษณา&lt;br/&gt;และผู้บริโภคที่เห็นโฆษณา" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF6600;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=14;" vertex="1" parent="1"><mxGeometry x="570" y="640" width="470" height="120" as="geometry"/></mxCell><mxCell id="Reg" value="🏛️ พนักงานเจ้าหน้าที่ / ตำรวจ&lt;br/&gt;ใช้ข้อมูลตรวจสอบย้อนหลัง" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontColor=#4B5563;fontSize=14;" vertex="1" parent="1"><mxGeometry x="305" y="820" width="470" height="110" as="geometry"/></mxCell><mxCell id="PenaltyNode" value="⚠️ ตัวประกาศไม่มีโทษเอง&lt;br/&gt;ผลรับผิดอยู่ที่ พ.ร.ก. (ม.8/10 ตามที่ สพธอ. แจ้ง)&lt;br/&gt;แพลตฟอร์มต้องพิสูจน์ว่าทำตามมาตรการ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;fontColor=#991B1B;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="1000" height="130" as="geometry"/></mxCell><mxCell id="e0" value="ประกาศใช้อย่างเป็นทางการ" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=12;" edge="1" parent="1" source="TitleNode" target="CoreEssence"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="ต่อยอดจากประกาศฉบับแรกที่ยังไม่ถูกยกเลิก" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=12;" edge="1" parent="1" source="CoreEssence" target="OldRule"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="เพิ่มหน้าที่ยืนยันตัวตนและเก็บข้อมูล" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=12;" edge="1" parent="1" source="CoreEssence" target="NewRule"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="1. กำหนดให้ตรวจตัวตนก่อนเผยแพร่โฆษณา" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=12;" edge="1" parent="1" source="NewRule" target="TechCompany"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="2. ขอเอกสารยืนยันตัวตนและข้อมูลผู้จ่ายเงิน" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=12;" edge="1" parent="1" source="TechCompany" target="EndUser"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="3. ส่งหลักฐานแสดงตนหรือยืนยันผ่าน Digital ID" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=12;" edge="1" parent="1" source="EndUser" target="TechCompany"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="4. เก็บข้อมูล 90 วันหลังโฆษณาสิ้นสุดให้ตรวจสอบ" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=12;" edge="1" parent="1" source="TechCompany" target="Reg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="5. ขอข้อมูลผู้ลงโฆษณาเมื่อพบโฆษณาหลอกลวง" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=12;" edge="1" parent="1" source="Reg" target="TechCompany"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="หากละเลยไม่ปฏิบัติตามมาตรการ" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=12;dashed=1;" edge="1" parent="1" source="TechCompany" target="PenaltyNode"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="ยังต้องถอดข้อมูลปลอมภายใน 24 ชม." style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=12;dashed=1;" edge="1" parent="1" source="OldRule" target="PenaltyNode"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>