<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net"><diagram name="แผนผังความสัมพันธ์" id="d1"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="CenterLaw" value="📜 ประกาศ คธอ. ฉบับที่ 2&lt;br/&gt;ยืนยันตัวตนผู้ลงโฆษณาบนสื่อสังคมออนไลน์&lt;br/&gt;(ศูนย์กลางการบังคับใช้)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B2545;strokeColor=#FF6600;fontColor=#FFFFFF;fontSize=14;" vertex="1" parent="1"><mxGeometry x="500" y="300" width="300" height="120" as="geometry"/></mxCell><mxCell id="Decree" value="พ.ร.ก.มาตรการป้องกันและปราบปราม&lt;br/&gt;อาชญากรรมทางเทคโนโลยี พ.ศ. 2566&lt;br/&gt;แก้ไข ฉบับที่ 2 พ.ศ. 2568 (ม.4/1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#0B2545;fontColor=#0B2545;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="320" height="110" as="geometry"/></mxCell><mxCell id="ETLaw" value="พ.ร.บ.ธุรกรรมทางอิเล็กทรอนิกส์&lt;br/&gt;พ.ศ. 2544 ม.37 (3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#0B2545;fontColor=#0B2545;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="320" height="90" as="geometry"/></mxCell><mxCell id="First" value="ประกาศ คธอ. ฉบับแรก&lt;br/&gt;(4 ก.ค. 2568) ถอดข้อมูลปลอม 24 ชม." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#0B2545;fontColor=#0B2545;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="320" height="90" as="geometry"/></mxCell><mxCell id="PDPA" value="PDPA พ.ศ. 2562&lt;br/&gt;(ข้อสังเกตเชิงปฏิบัติ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#0B2545;fontColor=#0B2545;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="320" height="80" as="geometry"/></mxCell><mxCell id="Platform" value="ผู้ให้บริการสื่อสังคมออนไลน์&lt;br/&gt;ที่รับค่าโฆษณา" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontSize=14;" vertex="1" parent="1"><mxGeometry x="940" y="120" width="300" height="100" as="geometry"/></mxCell><mxCell id="DigitalID" value="ผู้ให้บริการ Digital ID / ระบบยืนยันตัวตน&lt;br/&gt;ตามระดับที่ คธอ. กำหนด" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#FF6600;fontColor=#111827;fontSize=14;" vertex="1" parent="1"><mxGeometry x="940" y="300" width="300" height="100" as="geometry"/></mxCell><mxCell id="Advertiser" value="ผู้ลงโฆษณา / ผู้ชำระค่าโฆษณาแทน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;fontColor=#166534;fontSize=14;" vertex="1" parent="1"><mxGeometry x="940" y="480" width="300" height="90" as="geometry"/></mxCell><mxCell id="Public" value="ผู้บริโภคที่พบโฆษณา" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;fontColor=#166534;fontSize=14;" vertex="1" parent="1"><mxGeometry x="940" y="630" width="300" height="80" as="geometry"/></mxCell><mxCell id="Regulator" value="คธอ. / สพธอ. / กองป้องกันฯ&lt;br/&gt;และพนักงานเจ้าหน้าที่" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;fontColor=#991B1B;fontSize=14;" vertex="1" parent="1"><mxGeometry x="500" y="600" width="300" height="100" as="geometry"/></mxCell><mxCell id="e0" value="1. ออกตามอำนาจมาตรา 4/1 ของกฎหมายแม่" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=12;" edge="1" parent="1" source="CenterLaw" target="Decree"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="2. อ้างมาตรา 37 (3) เป็นที่มาของอำนาจ คธอ." style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=12;" edge="1" parent="1" source="CenterLaw" target="ETLaw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="3. ใช้ควบคู่ ไม่ปรากฏข้อยกเลิกฉบับแรก" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=12;" edge="1" parent="1" source="CenterLaw" target="First"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="4. ข้อมูลบัตรและใบหน้าต้องคุ้มครองตาม PDPA" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=12;dashed=1;" edge="1" parent="1" source="CenterLaw" target="PDPA"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="5. กำหนดหน้าที่พิสูจน์ตัวตนก่อนโฆษณา" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=12;" edge="1" parent="1" source="CenterLaw" target="Platform"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="6. เลือกใช้ Digital ID ตามระดับความน่าเชื่อถือ" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=12;" edge="1" parent="1" source="Platform" target="DigitalID"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="7. ส่งหลักฐานแสดงตนและข้อมูลติดต่อ" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=12;" edge="1" parent="1" source="Advertiser" target="Platform"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="8. อนุญาตลงโฆษณาหลังยืนยันตัวตนผ่าน" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=12;" edge="1" parent="1" source="Platform" target="Advertiser"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="9. เผยแพร่โฆษณาที่ผ่านการคัดกรอง" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=12;" edge="1" parent="1" source="Platform" target="Public"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="10. แจ้งเหตุโฆษณาหลอกลวง" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=12;dashed=1;" edge="1" parent="1" source="Public" target="Regulator"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="11. ขอข้อมูลผู้ลงโฆษณาที่เก็บไว้ 90 วัน" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=12;dashed=1;" edge="1" parent="1" source="Regulator" target="Platform"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="12. กำกับดูแลและบังคับใช้มาตรการ" style="endArrow=classic;html=1;strokeColor=#0B2545;fontSize=12;dashed=1;" edge="1" parent="1" source="Regulator" target="CenterLaw"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>